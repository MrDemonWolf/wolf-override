; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WOLF OVERRIDE"
config/version="0.15.0"
run/main_scene="res://scenes/studio_logo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/logo-mark.svg"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/brand/studio-logo-boot.png"
config/quit_on_go_back=false
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/WOLF--OVERRIDE"
config/custom_user_dir_name.linuxbsd="godot/app_userdata/WOLF--OVERRIDE"
config/custom_user_dir_name.web="godot/app_userdata/WOLF--OVERRIDE"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/fonts/game_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[internationalization]

locale/fallback="en"
locale/translations=PackedStringArray("res://i18n/es.po", "res://i18n/es_ES.po")
locale/translations_pot_files=PackedStringArray("res://scenes/main.tscn", "res://scenes/studio_logo.tscn", "res://scripts/blast_leaf.gd", "res://scripts/bypass_handle.gd", "res://scripts/dialogue_boxes.gd", "res://scripts/dock_bay.gd", "res://scripts/door_kit.gd", "res://scripts/door_leaf.gd", "res://scripts/drop_arm.gd", "res://scripts/floor_reflection.gd", "res://scripts/fx/fx_kit.gd", "res://scripts/fx/palette.gd", "res://scripts/fx/tri_mesh.gd", "res://scripts/fx/tweens.gd", "res://scripts/fx_presets.gd", "res://scripts/game_settings.gd", "res://scripts/hazard.gd", "res://scripts/hold_use.gd", "res://scripts/hud_text.gd", "res://scripts/i18n.gd", "res://scripts/impact.gd", "res://scripts/junction_room.gd", "res://scripts/m0_actor.gd", "res://scripts/m0_state.gd", "res://scripts/main.gd", "res://scripts/opening.gd", "res://scripts/pause_overlay.gd", "res://scripts/pressure_line.gd", "res://scripts/prop_screen.gd", "res://scripts/records_room.gd", "res://scripts/room_depth.gd", "res://scripts/seal_leaf.gd", "res://scripts/sentry.gd", "res://scripts/sentry_brain.gd", "res://scripts/sfx_bank.gd", "res://scripts/slide_leaf.gd", "res://scripts/story_text.gd", "res://scripts/studio_logo.gd", "res://scripts/swing_leaf.gd", "res://scripts/text_size.gd", "res://scripts/ui_label.gd", "res://scripts/ui_motion.gd", "res://scripts/wolf_lights.gd", "res://scripts/world/door_camera.gd")
pseudolocalization/expansion_ratio=0.3
pseudolocalization/replace_with_accents=false
