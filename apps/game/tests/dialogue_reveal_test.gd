extends "res://tests/support/game_suite.gd"
## Reveal timing, explicit completion, composite-character boundaries and stable native Label layout.


## Exercises the shared clock independently of puzzle state, then the native shaping behavior it needs.
func _run() -> void:
	check_name = "Dialogue reveal"
	var reveal: DialogueReveal = DialogueReveal.new()
	reveal.sync("page-1", "AB", false)
	reveal.tick(0.021, 50.0, 0.3)
	_expect(reveal.characters() == 1 and not reveal.done(), "Normal reveals a first character without completing the page")
	reveal.tick(0.021, 50.0, 0.3)
	_expect(reveal.characters() == 2 and reveal.done(), "the next character completes the same page")
	reveal.tick(0.5, 50.0, 0.3)
	var age: float = reveal.reading_age
	reveal.sync("page-1", "AB", false)
	_expect(reveal.done() and reveal.reading_age == age, "repeated layout does not restart a read page")
	reveal.sync("page-2", "AB", false)
	_expect(reveal.characters() == 0 and not reveal.done(), "an identical line on another page starts its own reveal")
	_expect(reveal.complete() and not reveal.complete(), "the first reading action completes text; the next is free to advance")
	_expect(reveal.done() and reveal.reading_age == 0.0, "manual completion starts a fresh reading interval")
	reveal.sync("instant", "A complete line.", true)
	_expect(reveal.done() and reveal.characters() == "A complete line.".length(), "Instant or Reduced Motion shows the whole page")
	reveal.sync("punctuation", "A. B", false)
	reveal.tick(0.021, 100.0, 0.3)
	_expect(reveal.characters() == 2, "the period is shown before its pause")
	reveal.tick(0.28, 100.0, 0.3)
	_expect(reveal.characters() == 2, "punctuation holds the following character")
	reveal.tick(0.05, 100.0, 0.3)
	_expect(reveal.done(), "reveal continues after the punctuation pause")
	for text: String in ["Dr. A", "W.O.L.F. A", "1.5 ok", "Mme. A"]:
		reveal.sync(text, text, false)
		reveal.tick(float(text.length()) / 100.0 + 0.01, 100.0, 0.3)
		_expect(reveal.done(), "an abbreviation or decimal does not add a sentence pause: %s" % text)
	reveal.sync("ellipsis", "A... B", false)
	reveal.tick(0.06, 100.0, 0.3)
	_expect(reveal.characters() == 4, "an ellipsis pauses once after all its dots")
	reveal.tick(0.33, 100.0, 0.3)
	_expect(reveal.done(), "a punctuation run does not multiply the pause")
	reveal.sync("cjk", "好。来", false)
	reveal.tick(0.025, 100.0, 0.3)
	_expect(reveal.characters() == 2, "a CJK full stop is a sentence mark")
	reveal.tick(0.2, 100.0, 0.3)
	_expect(reveal.characters() == 2, "CJK punctuation uses the same pause")
	reveal.sync("composite", "e\u0301👩‍🚀中", false)
	for expected: int in [2, 5, 6]:
		reveal.tick(0.021, 50.0, 0.3)
		_expect(reveal.characters() == expected, "accents and joined emoji reveal whole at offset %d" % expected)
	await _check_label_layout()
	await _check_reading_routes()
	finish("Dialogue reveal checks passed")


## Partial visibility must preserve the full text's wrapping/size; BEFORE_SHAPING would violate this.
func _check_label_layout() -> void:
	var label: Label = Label.new()
	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	label.visible_characters_behavior = TextServer.VC_CHARS_AFTER_SHAPING
	label.size = Vector2(120.0, 100.0)
	label.text = "A line with enough words to wrap."
	root.add_child(label)
	await settle(2)
	var lines: int = label.get_line_count()
	var minimum: Vector2 = label.get_minimum_size()
	label.visible_characters = 1
	await settle(2)
	_expect(lines > 1 and label.get_line_count() == lines and label.get_minimum_size() == minimum, "partial reveal keeps full-text line breaks and minimum size")
	label.queue_free()
	await settle(1)


## Drives the real presenter and stopped conversation route without advancing hazards or stations.
func _check_reading_routes() -> void:
	var game: Node2D = await start_game("dialogue-reading", keep_running)
	game.call("_new_game")
	game.call("_finish_intro")
	game.set_process(false)
	game.call("_drop_box_queue")
	var menu: GameSettings = game.get("settings_menu") as GameSettings
	menu.text_speed.select(1)
	menu.auto_advance.set_pressed_no_signal(false)
	game.call("_converse", "WOLF: Stay close.")
	game.call("_refresh_ui")
	var reveal: DialogueReveal = game.get("dialogue_reveal") as DialogueReveal
	_expect(not reveal.done(), "Normal starts a stopped conversation partially hidden")
	game.call("_read_pointer_dialogue")
	_expect(reveal.done() and not game.get("dialogue_cleared"), "first reading action reveals the final page without dismissing it")
	game.call("_tick_dialogue", 20.0)
	_expect(not game.get("dialogue_cleared"), "default manual mode keeps a fully read conversation")
	game.call("_read_pointer_dialogue")
	_expect(game.get("dialogue_cleared"), "next reading action dismisses the final page")
	game.call("_converse", "WOLF: Stay close.")
	game.call("_refresh_ui")
	_expect(not reveal.done(), "a repeated line after dismissal starts a new reveal")
	menu.auto_advance.set_pressed_no_signal(true)
	reveal.complete()
	game.call("_tick_dialogue", 20.0)
	_expect(game.get("dialogue_cleared") and game.get("dialogue_input_guard") > 0.0, "opt-in auto-advance dismisses read speech and arms its reading guard")
	game.call("_converse", "WOLF: Wait here.")
	game.call("_refresh_ui")
	game.call("_read_pointer_dialogue")
	_expect(not reveal.done() and not game.get("dialogue_cleared"), "the guard consumes reading input on the new line")
	game.set("dialogue_input_guard", 0.0)
	game.set("waiting_for_choice", true)
	reveal.complete()
	game.call("_tick_dialogue", 20.0)
	_expect(game.get("waiting_for_choice") and not game.get("dialogue_cleared"), "auto-advance never answers or dismisses a choice")
	game.call("_converse", "WOLF: Read the first part of this question before moving to the next page. Read the second part of this question before choosing an answer. Read the final part of this question and make your choice.")
	game.call("_refresh_ui")
	var page_count: int = (game.get("dialogue_boxes") as Array).size()
	_expect(page_count > 1, "question fixture genuinely spans pages")
	reveal.complete()
	game.call("_tick_dialogue", 20.0)
	_expect(game.get("dialogue_index") == 1 and game.get("waiting_for_choice"), "automatic reading advances question text without choosing an answer")
	game.set("dialogue_input_guard", 0.0)
	game.set("dialogue_index", page_count - 1)
	game.call("_refresh_ui")
	reveal.complete()
	game.call("_tick_dialogue", 20.0)
	_expect(game.get("waiting_for_choice") and not game.get("dialogue_cleared"), "the final question page waits even when automatic reading is enabled")
	game.set("dialogue_index", 0)
	game.set("dialogue_input_guard", 0.0)
	game.call("_refresh_ui")
	(game.get("touch_choice_1") as Button).grab_focus()
	game.set_process(true)
	use_input(true, &"pad")
	await settle(2)
	use_input(false, &"pad")
	await settle(2)
	_expect(reveal.done() and game.get("dialogue_index") == 0 and game.get("waiting_for_choice"), "native controller A completes Normal text before a focused answer can accept it")
	use_input(true, &"pad")
	await settle(2)
	use_input(false, &"pad")
	await settle(2)
	_expect(game.get("dialogue_index") == 1 and game.get("waiting_for_choice"), "the next native controller A reads one page without answering")
	game.set_process(false)
	game.set("waiting_for_choice", false)
	menu.auto_advance.set_pressed_no_signal(false)
	game.call("_converse", "WOLF: The contact is ready.")
	game.call("_refresh_ui")
	menu.reduced_motion.button_pressed = true
	game.call("_refresh_ui")
	_expect(reveal.done(), "Reduced Motion immediately completes the actual presented page")
	menu.reduced_motion.button_pressed = false
	game.call("_converse", "WOLF: The way is clear.")
	menu.text_speed.select(3)
	game.call("_refresh_ui")
	_expect(reveal.done(), "Instant shows the actual presented page without a reveal wait")
	menu.dialogue_backing.set_value_no_signal(0.8)
	game.call("_refresh_ui")
	var style: StyleBoxFlat = game.get("dialogue_backing_style") as StyleBoxFlat
	var other: Panel = game.get("top_card") as Panel
	_expect(is_equal_approx(style.bg_color.a, 0.8) and style != other.get_theme_stylebox(&"panel"), "backing changes the dialogue's own style without changing other cards")
	menu.text_speed.select(1)
	(game.get("debug_tools") as DebugTools).actions.jump(&"records_mirror")
	reveal = game.get("dialogue_reveal") as DialogueReveal
	game.call("debug_place", 830.0, 700.0)
	game.call("_interact_records", 830.0)
	_expect((game.get("state") as M0State).chapter_complete, "Records fixture secures the copy before testing its exit")
	game.call("_sync_dialogue_boxes")
	game.set("dialogue_index", (game.get("dialogue_boxes") as Array).size() - 1)
	game.call("_refresh_ui")
	_expect(not reveal.done(), "the final Records page starts with unread text")
	game.call("_interact_records", 830.0)
	_expect(reveal.done() and not game.get("records_exit_walking"), "Records exit USE reveals its final page without starting the walk out")
	game.call("_interact_records", 830.0)
	_expect(game.get("records_exit_walking"), "the next Records exit USE starts the authored walk out")
	game.set("dialogue_input_guard", 0.5)
	game.call("_new_game")
	game.call("_refresh_ui")
	var fresh_reveal: DialogueReveal = game.get("dialogue_reveal") as DialogueReveal
	_expect(game.get("dialogue_input_guard") == 0.0 and fresh_reveal != reveal and not fresh_reveal.done() and game.get("dialogue_index") == 0, "New Game starts a fresh Normal reveal without the previous reading guard")
	var checkpoint: M0State = (game.get("debug_tools") as DebugTools).actions.build_state(&"safe_point")
	_expect(checkpoint.save_to_disk(str(game.get("save_path"))), "a valid checkpoint is written for the reading reset check")
	game.set("dialogue_input_guard", 0.5)
	game.call("_load_game")
	_expect(game.get("dialogue_input_guard") == 0.0 and game.get("dialogue_reveal") != fresh_reveal, "a successful checkpoint load starts a fresh reading clock and clears the guard")
	await end_game(game)
