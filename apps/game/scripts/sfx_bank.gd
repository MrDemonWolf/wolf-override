class_name SfxBank
extends Node
## The game's sound effects. Most are generated by the recipes below into AudioStreamWAV buffers
## (16-bit mono, deterministic seed, every clip normalised to a -6 dB peak); a few are CC0
## recordings imported from assets/audio/, each registered with its source in assets/manifest.json.
## The short clips render at startup at 22.05 kHz. The detailed arc and growl recipes render at
## 44.1 kHz on a worker thread, so they never hold up the first frame. Every player sits on the
## Effects bus, so the Master and Effects sliders are the only controls over sound.

const MIX_RATE: int = 22050
## The detailed recipes keep their sizzle and grille detail above 5 kHz at this rate.
const DETAIL_RATE: int = 44100
const SEED: int = 0x574F4C46
## -6.02 dB, the loudest sample any clip reaches before the bus gain.
const PEAK: float = 0.5
const BUS: String = "Effects"
## One-shot voices, shared round-robin. The relief-vent burst runs 2.4 s, so there are enough that a
## busy moment does not cut it short.
const VOICES: int = 6
## Loops get their own player each so a room can hold and stop them by name.
const LOOPS: Array[StringName] = [&"hiss_low", &"hiss_mid", &"hiss_high", &"coolant_cloud", &"hum", &"servo", &"winch"]
## The junction's pressure-line loops at low, mid and high gauge: one length and one wrap point, so
## play_blend can run them in step and crossfade by the gauge.
const HISS_GAUGE: Array[StringName] = [&"hiss_low", &"hiss_mid", &"hiss_high"]
## Startup clip lengths in seconds (MIX_RATE); tests check the buffers against these.
const LENGTHS: Dictionary = {
	&"boom": 0.5,
	&"small_boom": 0.3,
	&"clank": 0.04,
	&"thud": 0.08,
	&"hum": 1.0,
	&"klaxon": 0.5,
	&"servo": 1.0,
	&"winch": 1.0,
	&"whine": 0.6,
}
## Detailed clip lengths in seconds (DETAIL_RATE), rendered on the worker thread.
const DETAILED: Dictionary = {
	&"relay_spark": 0.34,
	&"records_arc": 0.65,
	&"bolt_arc": 0.8,
	&"growl_warning": 1.2,
}
## Recorded clips (CC0; sources, authors and processing in assets/manifest.json).
const RECORDED: Dictionary = {
	&"hiss_low": preload("res://assets/audio/junction-pressure-loop-low.wav"),
	&"hiss_mid": preload("res://assets/audio/junction-pressure-loop-mid.wav"),
	&"hiss_high": preload("res://assets/audio/junction-pressure-loop-high.wav"),
	&"coolant_cloud": preload("res://assets/audio/junction-coolant-cloud-bed.wav"),
	&"vent_burst": preload("res://assets/audio/junction-relief-vent-burst.wav"),
	&"growl_seam": preload("res://assets/audio/wolf-growl-seam.wav"),
	&"growl_refusal": preload("res://assets/audio/wolf-growl-refusal.wav"),
}
## Where bolt_arc cracks: Main starts it this long before the whine ends so the crack lands on the drop.
const BOLT_CRACK_SECONDS: float = 0.5

var streams: Dictionary = {}
## How long the startup clips took to render on the main thread, in milliseconds.
var generation_ms: float = 0.0
var _voices: Array[AudioStreamPlayer] = []
var _loop_players: Dictionary = {}
var _next_voice: int = 0
## The worker task rendering DETAILED, or -1 once its clips are in streams.
var _detail_task: int = -1
## Filled by the worker; read only after the task has completed.
var _detail: Dictionary = {}


func _ready() -> void:
	var start: int = Time.get_ticks_usec()
	_render_startup()
	generation_ms = float(Time.get_ticks_usec() - start) / 1000.0
	_detail_task = WorkerThreadPool.add_task(_render_detail.bind(_detail), false, "SfxBank detailed clips")
	for index: int in VOICES:
		_voices.append(_add_player("Voice%d" % index))
	for loop_name: StringName in LOOPS:
		_loop_players[loop_name] = _add_player(String(loop_name).capitalize().replace(" ", "") + "Loop")


func _exit_tree() -> void:
	wait_for_detail()


## Blocks until the detailed clips are rendered and in streams. play() calls it for a detailed clip,
## which only waits if that clip is wanted within the first second or so after startup.
func wait_for_detail() -> void:
	if _detail_task < 0:
		return
	WorkerThreadPool.wait_for_task_completion(_detail_task)
	_detail_task = -1
	streams.merge(_detail, true)


## Plays [param clip] on a free voice (or that loop's own player) and returns the player, or null
## when the clip is unknown (a debug build warns, so a misspelt clip is never silently mute).
func play(clip: StringName, volume_db: float = 0.0, pitch: float = 1.0) -> AudioStreamPlayer:
	if not streams.has(clip) and DETAILED.has(clip):
		wait_for_detail()
	if not streams.has(clip):
		_warn_unknown(clip)
		return null
	var player: AudioStreamPlayer
	if _loop_players.has(clip):
		player = _loop_players[clip]
		if player.playing:
			player.volume_db = volume_db
			player.pitch_scale = pitch
			return player
	else:
		player = _voices[_next_voice]
		_next_voice = (_next_voice + 1) % VOICES
	player.stream = streams[clip]
	player.volume_db = volume_db
	player.pitch_scale = pitch
	player.play()
	return player


## Runs every loop in [param clips] in step (they must share one length) and crossfades across them
## with equal power as [param blend] goes 0..1: the first clip alone at 0, the last alone at 1 and two
## neighbours in between. If any of them has stopped, all restart together from the top.
func play_blend(clips: Array[StringName], blend: float, volume_db: float) -> void:
	var restart: bool = false
	for clip: StringName in clips:
		restart = restart or not (_loop_players[clip] as AudioStreamPlayer).playing
	var position: float = clampf(blend, 0.0, 1.0) * (clips.size() - 1)
	for index: int in clips.size():
		var player: AudioStreamPlayer = _loop_players[clips[index]]
		var weight: float = cos(clampf(absf(position - index), 0.0, 1.0) * PI * 0.5)
		player.volume_db = volume_db + linear_to_db(maxf(weight, 0.0001))
		player.pitch_scale = 1.0
		if restart:
			player.stream = streams[clips[index]]
			player.play()


## Stops the loop [param clip]; one-shots end on their own. A debug build warns on a name that is no
## loop, which would stop nothing.
func stop(clip: StringName) -> void:
	if _loop_players.has(clip):
		(_loop_players[clip] as AudioStreamPlayer).stop()
	elif not LOOPS.has(clip):
		_warn_unknown(clip)


func stop_each(clips: Array[StringName]) -> void:
	for clip: StringName in clips:
		stop(clip)


func stop_all() -> void:
	for player: AudioStreamPlayer in _voices:
		player.stop()
	for player: AudioStreamPlayer in _loop_players.values():
		player.stop()


## A clip name the bank does not know (or, for stop, a name that is no loop): warned in debug builds
## only, so a release build never prints for it.
func _warn_unknown(clip: StringName) -> void:
	if OS.is_debug_build():
		push_warning("SfxBank: no clip or loop named &\"%s\"; nothing plays or stops" % clip)


func players() -> Array[AudioStreamPlayer]:
	var all: Array[AudioStreamPlayer] = _voices.duplicate()
	for player: AudioStreamPlayer in _loop_players.values():
		all.append(player)
	return all


func _add_player(player_name: String) -> AudioStreamPlayer:
	var player: AudioStreamPlayer = AudioStreamPlayer.new()
	player.name = player_name
	player.bus = BUS
	add_child(player)
	return player


## Renders every generated clip on the calling thread and adds the recordings; calling it again
## produces identical buffers. Tests and tools use it; the running game renders DETAILED on a worker.
func generate() -> void:
	var start: int = Time.get_ticks_usec()
	_render_startup()
	generation_ms = float(Time.get_ticks_usec() - start) / 1000.0
	var detail: Dictionary = {}
	_render_detail(detail)
	streams.merge(detail, true)


func _render_startup() -> void:
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = SEED
	streams[&"boom"] = _wav(_boom(rng, LENGTHS[&"boom"], 55.0, 30.0, 0.18, 0.25, 1400.0, 110.0, 0.9), false)
	streams[&"small_boom"] = _wav(_boom(rng, LENGTHS[&"small_boom"], 90.0, 48.0, 0.09, 0.16, 900.0, 160.0, 0.5), false)
	streams[&"clank"] = _wav(_clank(rng, LENGTHS[&"clank"]), false)
	streams[&"thud"] = _wav(_thud(rng, LENGTHS[&"thud"]), false)
	streams[&"hum"] = _wav(_hum(LENGTHS[&"hum"]), true)
	streams[&"klaxon"] = _wav(_klaxon(LENGTHS[&"klaxon"]), false)
	streams[&"servo"] = _wav(_servo(LENGTHS[&"servo"]), true)
	streams[&"winch"] = _wav(_winch(LENGTHS[&"winch"]), true)
	streams[&"whine"] = _wav(_whine(rng, LENGTHS[&"whine"]), false)
	for clip: StringName in RECORDED:
		streams[clip] = RECORDED[clip]


## The detailed clips, each from its own fixed seed so the order (or the thread) never changes a byte.
## Runs on a worker thread in the game, so it touches nothing but [param into].
static func _render_detail(into: Dictionary) -> void:
	into[&"relay_spark"] = _wav(_arc_a(_seeded(SEED), ARC_PLANS[&"relay_spark"]), false, DETAIL_RATE)
	into[&"records_arc"] = _wav(_arc_b(_seeded(SEED), ARC_PLANS[&"records_arc"]), false, DETAIL_RATE)
	into[&"bolt_arc"] = _wav(_arc_b(_seeded(SEED), ARC_PLANS[&"bolt_arc"]), false, DETAIL_RATE)
	into[&"growl_warning"] = _wav(_growl_warning(_seeded(SEED ^ String(&"warning").hash())), false, DETAIL_RATE)


static func _seeded(seed: int) -> RandomNumberGenerator:
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = seed
	return rng


## A sine sub sweeping [param sub_from] to [param sub_to] Hz under a low-passed noise burst whose
## cutoff falls from [param lp_from] to [param lp_to] Hz, soft-clipped for weight.
static func _boom(rng: RandomNumberGenerator, seconds: float, sub_from: float, sub_to: float, sub_tau: float, noise_seconds: float, lp_from: float, lp_to: float, sub_mix: float) -> PackedFloat32Array:
	var frames: int = int(seconds * MIX_RATE)
	var out: PackedFloat32Array = PackedFloat32Array()
	out.resize(frames)
	var dt: float = 1.0 / MIX_RATE
	var phase: float = 0.0
	var low: float = 0.0
	for i: int in frames:
		var t: float = i * dt
		phase += TAU * lerpf(sub_from, sub_to, t / seconds) * dt
		var sample: float = sin(phase) * exp(-t / sub_tau) * sub_mix
		if t < noise_seconds:
			var cutoff: float = lerpf(lp_from, lp_to, t / noise_seconds)
			var alpha: float = dt / (1.0 / (TAU * cutoff) + dt)
			low += alpha * (rng.randf_range(-1.0, 1.0) - low)
			sample += low * exp(-t / 0.09) * 1.8
		out[i] = tanh(1.8 * sample) * minf(t / 0.004, 1.0)
	return out


## 40 ms of a 420 Hz square ring with a noise tick on top: the breaker clunk and relay contact.
static func _clank(rng: RandomNumberGenerator, seconds: float) -> PackedFloat32Array:
	var frames: int = int(seconds * MIX_RATE)
	var out: PackedFloat32Array = PackedFloat32Array()
	out.resize(frames)
	var dt: float = 1.0 / MIX_RATE
	for i: int in frames:
		var t: float = i * dt
		var square: float = 1.0 if fmod(t * 420.0, 1.0) < 0.5 else -1.0
		var sample: float = square * 0.6 * exp(-t / 0.012) + rng.randf_range(-1.0, 1.0) * exp(-t / 0.005)
		out[i] = sample * minf(t / 0.003, 1.0)
	return out


## 80 ms, 60 Hz sine with a short low noise knock: the door landing and the knockdown.
static func _thud(rng: RandomNumberGenerator, seconds: float) -> PackedFloat32Array:
	var frames: int = int(seconds * MIX_RATE)
	var out: PackedFloat32Array = PackedFloat32Array()
	out.resize(frames)
	var dt: float = 1.0 / MIX_RATE
	var alpha: float = dt / (1.0 / (TAU * 300.0) + dt)
	var low: float = 0.0
	for i: int in frames:
		var t: float = i * dt
		low += alpha * (rng.randf_range(-1.0, 1.0) - low)
		var sample: float = sin(TAU * 60.0 * t) * exp(-t / 0.03) + low * 0.8 * exp(-t / 0.01)
		out[i] = sample * minf(t / 0.004, 1.0)
	return out


## Looping 110 Hz saw with a 113 Hz detune, softened by a 500 Hz low-pass; both tones complete
## whole cycles in one second so the loop seam is silent.
static func _hum(seconds: float) -> PackedFloat32Array:
	var frames: int = int(seconds * MIX_RATE)
	var out: PackedFloat32Array = PackedFloat32Array()
	out.resize(frames)
	var dt: float = 1.0 / MIX_RATE
	var alpha: float = dt / (1.0 / (TAU * 500.0) + dt)
	var low: float = 0.0
	for i: int in frames:
		var t: float = i * dt
		var saw: float = (fmod(t * 110.0, 1.0) * 2.0 - 1.0) + (fmod(t * 113.0, 1.0) * 2.0 - 1.0)
		low += alpha * (saw * 0.5 - low)
		out[i] = low
	return out


## Three 120 ms square chirps at 880 Hz, 40 ms apart, low-passed so they bark instead of buzz:
## the seal-charged warning.
static func _klaxon(seconds: float) -> PackedFloat32Array:
	var frames: int = int(seconds * MIX_RATE)
	var out: PackedFloat32Array = PackedFloat32Array()
	out.resize(frames)
	var dt: float = 1.0 / MIX_RATE
	var alpha: float = dt / (1.0 / (TAU * 2500.0) + dt)
	var low: float = 0.0
	for i: int in frames:
		var t: float = i * dt
		var cycle: float = fmod(t, 0.16)
		var gate: float = 1.0 if t < 0.48 and cycle < 0.12 else 0.0
		var square: float = 1.0 if fmod(t * 880.0, 1.0) < 0.5 else -1.0
		# A short attack and release on every chirp so none of them clicks.
		var envelope: float = minf(cycle / 0.004, 1.0) * minf((0.12 - cycle) / 0.008, 1.0) if gate > 0.0 else 0.0
		low += alpha * (square * envelope - low)
		out[i] = low
	return out


## A thin 1.2 kHz servo tone with a 6 Hz vibrato and a soft octave, looped: the sentry's motors.
## The vibrato and both tones complete whole cycles in one second, so the loop seam is silent; the
## room raises its pitch when the sentry locks on and lets it fall away when the sentry goes down.
static func _servo(seconds: float) -> PackedFloat32Array:
	var frames: int = int(seconds * MIX_RATE)
	var out: PackedFloat32Array = PackedFloat32Array()
	out.resize(frames)
	var dt: float = 1.0 / MIX_RATE
	for i: int in frames:
		var t: float = i * dt
		# Phase of a 1200 Hz carrier swung +/-30 Hz at 6 Hz, integrated so it stays continuous.
		var phase: float = TAU * 1200.0 * t + (30.0 / 6.0) * sin(TAU * 6.0 * t)
		out[i] = sin(phase) * 0.7 + sin(phase * 0.5) * 0.3
	return out


## A 90 Hz saw with a 7 Hz wobble, low-passed, looped: the arm's winch hauling the tank back up.
static func _winch(seconds: float) -> PackedFloat32Array:
	var frames: int = int(seconds * MIX_RATE)
	var out: PackedFloat32Array = PackedFloat32Array()
	out.resize(frames)
	var dt: float = 1.0 / MIX_RATE
	var alpha: float = dt / (1.0 / (TAU * 700.0) + dt)
	var low: float = 0.0
	for i: int in frames:
		var t: float = i * dt
		var saw: float = fmod(t * 90.0, 1.0) * 2.0 - 1.0
		low += alpha * (saw - low)
		out[i] = low * (0.75 + 0.25 * sin(TAU * 7.0 * t))
	return out


## A rising electrical whine (a sine sweeping 300 Hz to 1.8 kHz with a buzzing square edge) that
## swells over 0.6 s and cuts off: the exit bolt charging before it arcs.
static func _whine(rng: RandomNumberGenerator, seconds: float) -> PackedFloat32Array:
	var frames: int = int(seconds * MIX_RATE)
	var out: PackedFloat32Array = PackedFloat32Array()
	out.resize(frames)
	var dt: float = 1.0 / MIX_RATE
	var phase: float = 0.0
	for i: int in frames:
		var t: float = i * dt
		var progress: float = t / seconds
		phase += TAU * lerpf(300.0, 1800.0, progress * progress) * dt
		var tone: float = sin(phase) * 0.7 + (1.0 if sin(phase * 0.5) > 0.0 else -1.0) * 0.15
		var envelope: float = minf(t / 0.02, 1.0) * lerpf(0.3, 1.0, progress) * minf((seconds - t) / 0.01, 1.0)
		out[i] = (tone + rng.randf_range(-0.08, 0.08)) * envelope
	return out


# --- Electrical arcs (44.1 kHz) ---------------------------------------------------------------
# Shared rules: the buzz sits on 120 Hz (US 60 Hz mains: an arc reignites twice per cycle) but is
# carried by its 240 Hz-2.4 kHz harmonics so phones hear it, rumble below 40 Hz is high-passed out,
# everything above about 9 kHz is rolled off, and every clip starts and ends on exactly 0.
# Recipe A (the relay spark) builds Farnell-style layers (Designing Sound, "Electricity"); recipe B
# (the Records exit and the exit bolt) models the discharge physically.

const MAINS_HZ: float = 60.0
const BUZZ_HZ: float = 120.0
## Depth of the 120 Hz reignition pulse on recipe A's buzz and sizzle.
const PULSE_DEPTH: float = 0.6
## Send from recipe B's N-wave crackle to its two Q 9 housing resonators (a plan's "ring_send"
## overrides it).
const RING_SEND: float = 0.4
## Recipe B's housing modes struck by a crack: [Hz, level, decay seconds]. Short decays (6-12 ms) knock
## instead of ringing; a plan with "long_ring" keeps the 20-50 ms decays of the bolt clip that was
## auditioned, together with its 0.8 ring send.
const HOUSING_MODES: Array = [[520.0, 0.3, 0.012], [1150.0, 0.45, 0.010], [1730.0, 0.5, 0.008], [2650.0, 0.45, 0.007], [3900.0, 0.3, 0.006]]
const HOUSING_MODES_LONG: Array = [[520.0, 0.3, 0.05], [1150.0, 0.45, 0.04], [1730.0, 0.5, 0.035], [2650.0, 0.45, 0.03], [3900.0, 0.3, 0.02]]

enum { LOWPASS, HIGHPASS, BANDPASS, HIGHSHELF, PEAKING }

## Timing plans. crack_at: the main strike. restrike_at: a smaller second strike (-1 for none).
## build_rate: crackle impulses per second at the start and end of a build (before crack_at).
## post_rate / post_tau: crackle rate right after the strike and how fast it thins.
## buzz_pre: buzz level reached at the end of the build. buzz_post / buzz_hold / buzz_tau: buzz
## after the strike. zap_seconds / zap: the falling high-voltage sweep. tail / tail_tau: sizzle.
## drive: the tanh bus drive. crackle_fade: [start, end] seconds over which the crackle level falls
## to 0 (a raised cosine), so no lone late spit stands above a dying tail. ring_send / long_ring:
## recipe B's housing ring (see RING_SEND and HOUSING_MODES).
const ARC_PLANS: Dictionary = {
	&"relay_spark": {
		"seconds": 0.34, "crack_at": 0.004, "crack": 0.65, "restrike_at": 0.055, "restrike": 0.3,
		"build_rate": [0.0, 0.0], "post_rate": 240.0, "post_tau": 0.05,
		"buzz_pre": 0.0, "buzz_post": 0.45, "buzz_hold": 0.025, "buzz_tau": 0.03,
		"zap_seconds": 0.035, "zap": 0.35, "tail": 0.22, "tail_tau": 0.06, "drive": 3.2,
	},
	&"records_arc": {
		"seconds": 0.65, "crack_at": 0.006, "crack": 1.0, "restrike_at": 0.15, "restrike": 0.55,
		"build_rate": [0.0, 0.0], "post_rate": 280.0, "post_tau": 0.15,
		"buzz_pre": 0.0, "buzz_post": 0.75, "buzz_hold": 0.1, "buzz_tau": 0.11,
		"zap_seconds": 0.08, "zap": 0.55, "tail": 0.35, "tail_tau": 0.18, "drive": 5.0,
		"crackle_fade": [0.36, 0.48],
	},
	# Buzz and crackle build under the end of the whine for 0.5 s (BOLT_CRACK_SECONDS), then it cracks.
	# It keeps the longer housing ring of the auditioned clip (synth recipe B, before the refine pass).
	&"bolt_arc": {
		"seconds": 0.8, "crack_at": BOLT_CRACK_SECONDS, "crack": 1.0, "restrike_at": 0.585, "restrike": 0.45,
		"build_rate": [15.0, 230.0], "post_rate": 320.0, "post_tau": 0.085,
		"buzz_pre": 0.7, "buzz_post": 0.8, "buzz_hold": 0.05, "buzz_tau": 0.07,
		"zap_seconds": 0.09, "zap": 0.6, "tail": 0.35, "tail_tau": 0.1, "drive": 3.0,
		"ring_send": 0.8, "long_ring": true,
	},
}


## Recipe A: a detuned 119.8 / 120.2 Hz buzz (beating), soft-clipped and rung through a short comb;
## chirp-impulse crackle phase-locked to the mains peaks; a snap made of an FM sine sweep plus a noise
## burst through a formant bank (480 / 720 / 2600 / 4600 / 7200 Hz); a falling zap ring-modulated by
## the 120 Hz buzz; band-passed sizzle with random flicker. The buzz and sizzle pulse at 120 Hz.
static func _arc_a(rng: RandomNumberGenerator, plan: Dictionary) -> PackedFloat32Array:
	var n: int = int(plan["seconds"] * DETAIL_RATE)
	var dt: float = 1.0 / DETAIL_RATE
	var crack_at: float = plan["crack_at"]
	var out: PackedFloat32Array = _zeros(n)

	var table: PackedFloat32Array = _harmonic_table(rng, 36, 1.0, 1.0)
	var wobble: PackedFloat32Array = _smooth_noise(rng, n, 30.0)
	var buzz: PackedFloat32Array = _zeros(n)
	var ph1: float = 0.0
	var ph2: float = 0.0
	for i: int in n:
		ph1 = fmod(ph1 + (BUZZ_HZ - 0.2) * dt, 1.0)
		ph2 = fmod(ph2 + (BUZZ_HZ + 0.2) * dt, 1.0)
		var s: float = tanh(1.8 * (_table_read(table, ph1) + _table_read(table, ph2)))
		buzz[i] = s * (1.0 + 0.5 * wobble[i])
	buzz = _comb(buzz, 0.0031, 0.35)
	buzz = _biquad(buzz, HIGHPASS, 280.0, 0.707)
	var dark: PackedFloat32Array = _biquad(buzz, LOWPASS, 700.0, 0.707)
	buzz = _biquad(buzz, LOWPASS, 2600.0, 0.707)
	var reignite: PackedFloat32Array = _reignition(n, plan)
	for i: int in n:
		var t: float = i * dt
		var p: float = pow(_arc_progress(t, plan), 1.5)
		buzz[i] = lerpf(dark[i] * 1.6, buzz[i], p) * _buzz_env(t, plan) * reignite[i]
	_mix(out, buzz, 0.5)

	var crackle: PackedFloat32Array = _zeros(n)
	for event: Array in _crackle_events(rng, plan, true):
		var start: int = int(event[0] * DETAIL_RATE)
		var f_hi: float = rng.randf_range(2500.0, 5500.0)
		var f_lo: float = rng.randf_range(600.0, 900.0)
		var tau: float = rng.randf_range(0.0005, 0.0016)
		var phase: float = rng.randf() * TAU
		for k: int in mini(int(tau * 6.0 * DETAIL_RATE), n - start):
			var tt: float = k * dt
			phase += TAU * (f_lo + (f_hi - f_lo) * exp(-tt / 0.0012)) * dt
			crackle[start + k] += event[1] * cos(phase) * exp(-tt / tau)
	crackle = _biquad(crackle, HIGHPASS, 300.0, 0.707)
	_mix(out, crackle, 0.75)

	var snap: PackedFloat32Array = _zeros(n)
	_a_snap(rng, snap, crack_at, plan["crack"])
	if plan["restrike_at"] > 0.0:
		_a_snap(rng, snap, plan["restrike_at"], plan["restrike"])
	var formants: PackedFloat32Array = _zeros(n)
	var bands: Array = [[480.0, 2.0, 0.8], [720.0, 2.0, 0.7], [2600.0, 1.5, 1.0], [4600.0, 3.0, 0.5], [7200.0, 3.0, 0.25]]
	for band: Array in bands:
		_mix(formants, _biquad(snap, BANDPASS, band[0], band[1]), band[2])
	_mix(formants, snap, 0.3)
	_mix(out, formants, 1.0)

	var zap_seconds: float = plan["zap_seconds"]
	var start_zap: int = int(crack_at * DETAIL_RATE)
	var zphase: float = 0.0
	for k: int in mini(int(zap_seconds * 1.6 * DETAIL_RATE), n - start_zap):
		var tt: float = k * dt
		zphase += TAU * (350.0 + 2050.0 * exp(-tt / (zap_seconds * 0.35))) * dt
		var ring: float = 0.55 + 0.45 * tanh(4.0 * sin(TAU * BUZZ_HZ * tt))
		var env: float = minf(tt / 0.002, 1.0) * exp(-tt / (zap_seconds * 0.5))
		out[start_zap + k] += sin(zphase) * ring * env * plan["zap"] * 0.6

	var sizzle: PackedFloat32Array = _biquad(_white(rng, n), BANDPASS, 3200.0, 0.8)
	var flicker: PackedFloat32Array = _smooth_noise(rng, n, 70.0)
	for i: int in n:
		var t: float = i * dt
		sizzle[i] *= (0.3 + absf(flicker[i])) * _tail_env(t, plan) * reignite[i]
	_mix(out, sizzle, 1.3)
	return _arc_finish(out, plan["drive"], -2.0)


## The arc reignites on every half-cycle of the 60 Hz supply: a gain of mean 1 that is
## (1 - PULSE_DEPTH) between half-cycles and peaks on |sin(2*pi*60t)|^4 (the phase the crackle is
## locked to, with a slight 8 Hz jitter). It has its own fixed seed so the other layers' draws stay put.
static func _reignition(frames: int, plan: Dictionary) -> PackedFloat32Array:
	var out: PackedFloat32Array = _zeros(frames)
	var jitter: PackedFloat32Array = _smooth_noise(_seeded(SEED ^ 0x5055), frames, 8.0)
	var dt: float = 1.0 / DETAIL_RATE
	for i: int in frames:
		var t: float = i * dt
		var depth: float = PULSE_DEPTH * pow(_arc_progress(t, plan), 2.0)
		var s4: float = pow(sin(TAU * MAINS_HZ * t + 0.3 * jitter[i]), 4.0)
		out[i] = (1.0 - depth) + depth * s4 / 0.375
	return out


## The spark snap: an FM sine dropping from about 7 kHz to 250 Hz in a few milliseconds over a fast
## noise burst with a quieter long tail.
static func _a_snap(rng: RandomNumberGenerator, out: PackedFloat32Array, at: float, amp: float) -> void:
	var start: int = int(at * DETAIL_RATE)
	var dt: float = 1.0 / DETAIL_RATE
	var phase: float = 0.0
	for k: int in mini(int(0.25 * DETAIL_RATE), out.size() - start):
		var tt: float = k * dt
		phase += TAU * (250.0 + 6750.0 * exp(-tt / 0.0025)) * dt
		var tone: float = sin(phase) * exp(-tt / 0.006)
		var noise: float = rng.randf_range(-1.0, 1.0) * (exp(-tt / 0.008) + 0.2 * exp(-tt / 0.08))
		out[start + k] += (tone * 0.8 + noise) * amp * minf(tt / 0.0003, 1.0)


## Recipe B: each micro-discharge is an acoustic N-wave whose width grows with its energy; the crack
## is a big N-wave that strikes the housing's modes (520-3900 Hz, HOUSING_MODES); the body is noise reignited on every mains half-cycle plus a faint 120 Hz hum; the
## zap is noise through a resonant band-pass sweeping 4.5 kHz to 450 Hz; the tail still pulses.
static func _arc_b(rng: RandomNumberGenerator, plan: Dictionary) -> PackedFloat32Array:
	var n: int = int(plan["seconds"] * DETAIL_RATE)
	var dt: float = 1.0 / DETAIL_RATE
	var crack_at: float = plan["crack_at"]
	var out: PackedFloat32Array = _zeros(n)

	var body: PackedFloat32Array = _biquad(_white(rng, n), BANDPASS, 1500.0, 0.6)
	body = _biquad(body, HIGHPASS, 400.0, 0.707)
	var jitter: PackedFloat32Array = _smooth_noise(rng, n, 8.0)
	var hum_amps: Array = [0.5, 1.0, 0.7, 0.55, 0.35, 0.25, 0.18, 0.12]
	var hum_phases: Array = []
	for k: int in hum_amps.size():
		hum_phases.append(rng.randf() * TAU)
	var dark: PackedFloat32Array = _biquad(body, LOWPASS, 900.0, 0.707)
	for i: int in n:
		var t: float = i * dt
		var p: float = _arc_progress(t, plan)
		var mains: float = absf(sin(TAU * MAINS_HZ * t + 0.6 * jitter[i]))
		var pulse: float = 0.12 + pow(mains, 6.0)
		var hum: float = 0.0
		for k: int in hum_amps.size():
			hum += hum_amps[k] * sin(TAU * BUZZ_HZ * (k + 1) * t + hum_phases[k])
		var noise: float = lerpf(dark[i] * 1.5, body[i], pow(p, 1.5))
		body[i] = (noise * pulse * 2.2 + hum * 0.15 * lerpf(0.4, 1.0, p)) * _buzz_env(t, plan)
	_mix(out, body, 0.8)

	var crackle: PackedFloat32Array = _zeros(n)
	for event: Array in _crackle_events(rng, plan, true):
		_n_wave(crackle, event[0], event[1], 0.00009 + 0.00045 * event[1] * rng.randf_range(0.6, 1.0))
	crackle = _biquad(crackle, PEAKING, 2200.0, 0.9, 5.0)
	var ring: PackedFloat32Array = _biquad(crackle, BANDPASS, 1730.0, 9.0)
	_mix(ring, _biquad(crackle, BANDPASS, 2650.0, 9.0), 1.0)
	_mix(crackle, ring, float(plan.get("ring_send", RING_SEND)))
	crackle = _biquad(crackle, HIGHPASS, 350.0, 0.707)
	_mix(out, crackle, 1.3)

	var modes: Array = HOUSING_MODES_LONG if plan.get("long_ring", false) else HOUSING_MODES
	_b_crack(rng, out, crack_at, plan["crack"], modes)
	if plan["restrike_at"] > 0.0:
		_b_crack(rng, out, plan["restrike_at"], plan["restrike"], modes)

	var zap_seconds: float = plan["zap_seconds"]
	var start_zap: int = int(crack_at * DETAIL_RATE)
	var zlen: int = mini(int(zap_seconds * 1.8 * DETAIL_RATE), n - start_zap)
	var zap: PackedFloat32Array = _swept_bandpass(_white(rng, zlen), 4500.0, 450.0, zap_seconds, 10.0)
	for k: int in zlen:
		var tt: float = k * dt
		out[start_zap + k] += zap[k] * minf(tt / 0.002, 1.0) * exp(-tt / (zap_seconds * 0.55)) * plan["zap"] * 2.2

	var tail: PackedFloat32Array = _biquad(_white(rng, n), BANDPASS, 3000.0, 0.7)
	for i: int in n:
		var t: float = i * dt
		tail[i] *= (0.25 + pow(absf(sin(TAU * MAINS_HZ * t)), 3.0)) * _tail_env(t, plan)
	_mix(out, tail, 0.8)
	return _arc_finish(out, plan["drive"], -1.5)


## Adds an N-wave (a spark's pressure signature: a jump up, a linear fall through zero to an equal
## negative, a jump back) of [param width] seconds.
static func _n_wave(out: PackedFloat32Array, at: float, amp: float, width: float) -> void:
	var start: int = int(at * DETAIL_RATE)
	var w: int = maxi(int(width * DETAIL_RATE), 3)
	for k: int in mini(w, out.size() - start):
		out[start + k] += amp * (1.0 - 2.0 * float(k) / float(w - 1))


static func _b_crack(rng: RandomNumberGenerator, out: PackedFloat32Array, at: float, amp: float, modes: Array) -> void:
	_n_wave(out, at, amp * 1.4, 0.0009)
	var start: int = int(at * DETAIL_RATE)
	var dt: float = 1.0 / DETAIL_RATE
	for k: int in mini(int(0.3 * DETAIL_RATE), out.size() - start):
		var tt: float = k * dt
		var s: float = rng.randf_range(-1.0, 1.0) * exp(-tt / 0.005) * 0.7
		for mode: Array in modes:
			s += sin(TAU * mode[0] * tt) * mode[1] * exp(-tt / mode[2])
		out[start + k] += s * amp


## How far through the build [param t] is (0..1), or 1 after the strike.
static func _arc_progress(t: float, plan: Dictionary) -> float:
	var crack_at: float = plan["crack_at"]
	return 1.0 if t >= crack_at or crack_at < 0.05 else t / crack_at


## Buzz level: swells over the build, holds after the strike, then decays.
static func _buzz_env(t: float, plan: Dictionary) -> float:
	var crack_at: float = plan["crack_at"]
	if t < crack_at:
		return plan["buzz_pre"] * pow(t / crack_at, 1.6) if crack_at >= 0.05 else 0.0
	var d: float = t - crack_at
	var hold: float = plan["buzz_hold"]
	var level: float = plan["buzz_post"]
	return level * minf(d / 0.002, 1.0) * (1.0 if d < hold else exp(-(d - hold) / plan["buzz_tau"]))


## Crackle impulses per second at [param t].
static func _crackle_rate(t: float, plan: Dictionary) -> float:
	var crack_at: float = plan["crack_at"]
	if t < crack_at:
		if crack_at < 0.05:
			return 0.0
		var rates: Array = plan["build_rate"]
		return lerpf(rates[0], rates[1], pow(t / crack_at, 2.0))
	var rate: float = plan["post_rate"] * exp(-(t - crack_at) / plan["post_tau"])
	var restrike_at: float = plan["restrike_at"]
	if restrike_at > 0.0 and t >= restrike_at:
		rate += plan["post_rate"] * 0.6 * exp(-(t - restrike_at) / (plan["post_tau"] * 0.7))
	return rate


## After a strike, later impulses get quieter as well as rarer, so no lone pop sits in the tail.
static func _crackle_level(t: float, plan: Dictionary) -> float:
	var crack_at: float = plan["crack_at"]
	if t < crack_at:
		return 1.0
	var level: float = exp(-(t - crack_at) / (plan["post_tau"] * 2.0))
	var restrike_at: float = plan["restrike_at"]
	if restrike_at > 0.0 and t >= restrike_at:
		level = maxf(level, 0.7 * exp(-(t - restrike_at) / (plan["post_tau"] * 1.4)))
	var floor_level: float = 0.03 + 0.97 * level
	if plan.has("crackle_fade"):
		var fade: Array = plan["crackle_fade"]
		var x: float = clampf((t - float(fade[0])) / (float(fade[1]) - float(fade[0])), 0.0, 1.0)
		floor_level *= 0.5 + 0.5 * cos(PI * x)
	return floor_level


## Sizzle level: creeps up during a build, blooms after the strike and dies away.
static func _tail_env(t: float, plan: Dictionary) -> float:
	var crack_at: float = plan["crack_at"]
	if t < crack_at:
		return plan["tail"] * 0.35 * pow(t / crack_at, 3.0) if crack_at >= 0.05 else 0.0
	var d: float = t - crack_at
	return plan["tail"] * (1.0 - exp(-d / 0.008)) * exp(-d / plan["tail_tau"])


## Crackle events as [time, amplitude] pairs: a thinned Poisson process following _crackle_rate.
## With [param lock_mains] the impulses bunch near the voltage peaks of the 60 Hz cycle, which is
## what makes real crackle sound mains-driven. Faded-out events stay in the list at zero amplitude so
## later random draws are unchanged.
static func _crackle_events(rng: RandomNumberGenerator, plan: Dictionary, lock_mains: bool) -> Array:
	var events: Array = []
	var seconds: float = plan["seconds"]
	var max_rate: float = 900.0
	var t: float = 0.0
	while true:
		t += -log(maxf(rng.randf(), 1e-6)) / max_rate
		if t >= seconds - 0.035:
			break
		var accept: float = _crackle_rate(t, plan) / max_rate
		if lock_mains:
			accept *= (8.0 / 3.0) * pow(sin(TAU * MAINS_HZ * t), 4.0)
		if rng.randf() < accept:
			var level: float = lerpf(0.3, 1.0, _arc_progress(t, plan)) * _crackle_level(t, plan)
			events.append([t, (0.12 + 0.88 * pow(rng.randf(), 2.4)) * level])
	return events


## The arcs' output stage: 40 Hz high-pass x2, a 9 kHz low-pass and a high shelf that tilts the fizz
## down, then tanh bus saturation last (it lowers the crest so the arc reads as loud as the other
## clips at the same peak), then raised-cosine edges so the clip starts and ends on exactly 0.
static func _arc_finish(samples: PackedFloat32Array, drive: float, shelf_db: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _biquad(samples, HIGHPASS, 40.0, 0.707)
	out = _biquad(out, HIGHPASS, 40.0, 0.707)
	out = _biquad(out, LOWPASS, 9000.0, 0.707)
	out = _biquad(out, HIGHSHELF, 5000.0, 0.707, shelf_db)
	var peak: float = _peak(out)
	if peak <= 0.0:
		return out
	for i: int in out.size():
		out[i] = tanh(drive * out[i] / peak) / tanh(drive)
	var fade_in: int = int(0.0015 * DETAIL_RATE)
	var fade_out: int = int(0.025 * DETAIL_RATE)
	var n: int = out.size()
	for i: int in fade_in:
		out[i] *= 0.5 - 0.5 * cos(PI * float(i) / fade_in)
	for i: int in fade_out:
		out[n - 1 - i] *= 0.5 - 0.5 * cos(PI * float(i) / fade_out)
	out[0] = 0.0
	out[n - 1] = 0.0
	return out


## One period of a 120 Hz harmonic series (amplitude 1 / k^[param tilt], fixed random phases),
## 2048 points, band-limited to [param harmonics] partials so it never aliases.
static func _harmonic_table(rng: RandomNumberGenerator, harmonics: int, tilt: float, odd_boost: float) -> PackedFloat32Array:
	var size: int = 2048
	var table: PackedFloat32Array = _zeros(size)
	for k: int in range(1, harmonics + 1):
		var amp: float = 1.0 / pow(float(k), tilt) * (odd_boost if k % 2 == 1 else 1.0)
		var phase: float = rng.randf() * TAU
		for i: int in size:
			table[i] += amp * sin(TAU * k * float(i) / size + phase)
	var peak: float = _peak(table)
	for i: int in size:
		table[i] /= peak
	return table


static func _table_read(table: PackedFloat32Array, phase: float) -> float:
	var pos: float = phase * table.size()
	var index: int = int(pos) % table.size()
	return lerpf(table[index], table[(index + 1) % table.size()], pos - floorf(pos))


## A feedback comb: a short delay that rings the buzz like a metal enclosure.
static func _comb(input: PackedFloat32Array, delay_s: float, feedback: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _zeros(input.size())
	var d: int = maxi(int(delay_s * DETAIL_RATE), 1)
	for i: int in input.size():
		out[i] = input[i] + (out[i - d] * feedback if i >= d else 0.0)
	return out


## A band-pass whose centre glides exponentially from [param from_hz] to [param to_hz] over
## [param seconds]; coefficients are refreshed every 16 samples (a swept resonant filter).
static func _swept_bandpass(input: PackedFloat32Array, from_hz: float, to_hz: float, seconds: float, q: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _zeros(input.size())
	var x1: float = 0.0
	var x2: float = 0.0
	var y1: float = 0.0
	var y2: float = 0.0
	var b0: float = 0.0
	var a1: float = 0.0
	var a2: float = 0.0
	for i: int in input.size():
		if i % 16 == 0:
			var progress: float = minf(float(i) / (seconds * DETAIL_RATE), 1.0)
			var freq: float = from_hz * pow(to_hz / from_hz, progress)
			var w0: float = TAU * freq / DETAIL_RATE
			var alpha: float = sin(w0) / (2.0 * q)
			b0 = alpha / (1.0 + alpha)
			a1 = -2.0 * cos(w0) / (1.0 + alpha)
			a2 = (1.0 - alpha) / (1.0 + alpha)
		var x: float = input[i]
		var y: float = b0 * x - b0 * x2 - a1 * y1 - a2 * y2
		x2 = x1
		x1 = x
		y2 = y1
		y1 = y
		out[i] = y
	return out


## One-pole smoothed noise in roughly -1..1, for slow wobble and amplitude flicker.
static func _smooth_noise(rng: RandomNumberGenerator, frames: int, cutoff: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _zeros(frames)
	var dt: float = 1.0 / DETAIL_RATE
	var alpha: float = dt / (1.0 / (TAU * cutoff) + dt)
	var gain: float = sqrt(3.0 / alpha)
	var state: float = 0.0
	for i: int in frames:
		state += alpha * (rng.randf_range(-1.0, 1.0) - state)
		out[i] = clampf(state * gain * 0.35, -1.0, 1.0)
	return out


# --- WOLF's lane warning growl (44.1 kHz) -----------------------------------------------------
# A source-filter voice (Fant 1960; Klatt 1980): a differentiated Rosenberg glottal pulse train with
# jitter, shimmer, subharmonics and chaotic period jumps (Fitch, Neubauer & Herzel 2002), breath
# noise and 20-40 Hz roughness, through formants spaced for a ~20 cm vocal tract (Riede & Fitch 1999),
# so his identity sits at 300 Hz-3.5 kHz where phone speakers play. Every pulse rings a metal
# chassis; a grille rattles on the loud parts. A contour (a wandering swell and two snarl bursts)
# keeps it from sounding like a held note.

## f0 contour (start, middle, end Hz), swell and die-away seconds, roughness rate (Hz) and depth, how
## open the mouth is (raises F1 and F2), breath share and subharmonic depth.
const GROWL_SHAPE: Dictionary = {"f0": [74.0, 83.0, 69.0], "attack": 0.16, "release": 0.34, "rough_hz": 27.0, "rough": 0.5, "open": 0.55, "breath": 0.35, "sub": 0.25}
## The swell (rate, depth in dB, F1 sweep in Hz) and the bursts ([centre, length] seconds, extra dB,
## F2 and f0 lift). post: the share of the contour applied after the tanh glue so the glue cannot
## flatten it. rattle and air: the grille rattle and the 1.6-4.5 kHz snarl band inside the bursts.
const GROWL_CONTOUR: Dictionary = {"swell_hz": 2.4, "swell_db": 5.0, "f1_sweep": 120.0, "bursts": [[0.45, 0.13], [0.8, 0.12]], "burst_db": 6.0, "burst_f2": 400.0, "burst_f0": 0.1, "post": 0.85, "rattle": 0.2, "air": 0.5}
## The envelope reaches zero this long before the clip ends, so resonances ring out before the fade.
const GROWL_TAIL: float = 0.06


static func _growl_warning(rng: RandomNumberGenerator) -> PackedFloat32Array:
	var seconds: float = DETAILED[&"growl_warning"]
	var shape: Dictionary = GROWL_SHAPE
	var contour: Dictionary = GROWL_CONTOUR
	var base: PackedFloat32Array = _growl_envelope(seconds, shape)
	var n: int = base.size()
	var swell_hz: float = contour["swell_hz"]
	var swell_db: float = contour["swell_db"]
	var burst_db: float = contour["burst_db"]
	var post: float = contour["post"]
	var bursts: Array = contour["bursts"]
	var swell_phase: float = rng.randf() * TAU
	var gain_db: PackedFloat32Array = _zeros(n)
	var burst: PackedFloat32Array = _zeros(n)
	var swell: PackedFloat32Array = _zeros(n)
	var top: float = -INF
	for i: int in n:
		var t: float = float(i) / DETAIL_RATE
		# The swell rate wanders slowly (+-15%) so it does not read as a tremolo.
		var s: float = sin(TAU * swell_hz * t * (1.0 + 0.15 * sin(TAU * 0.7 * t)) + swell_phase)
		var b: float = 0.0
		for pair: Array in bursts:
			var x: float = (t - float(pair[0])) / float(pair[1])
			# Flat-topped (Tukey) burst: full level over the middle half, raised-cosine ramps either side.
			if absf(x) < 0.5:
				b = maxf(b, 1.0 if absf(x) < 0.25 else 0.5 + 0.5 * cos(PI * (absf(x) - 0.25) / 0.25))
		swell[i] = 0.5 + 0.5 * s
		burst[i] = b
		gain_db[i] = 0.5 * swell_db * s + burst_db * b
		top = maxf(top, gain_db[i])
	var env: PackedFloat32Array = _zeros(n)
	var f0_mul: PackedFloat32Array = _zeros(n)
	var f1_add: PackedFloat32Array = _zeros(n)
	var f2_add: PackedFloat32Array = _zeros(n)
	var f1_sweep: float = contour["f1_sweep"]
	var burst_f2: float = contour["burst_f2"]
	var burst_f0: float = contour["burst_f0"]
	for i: int in n:
		# Peak-normalised, so env reaches 1 only inside a burst and the rattle gate opens there.
		env[i] = base[i] * pow(10.0, (gain_db[i] - top) * (1.0 - post) / 20.0)
		f0_mul[i] = 1.0 + burst_f0 * burst[i]
		f1_add[i] = f1_sweep * (swell[i] - 0.5) + 0.6 * f1_sweep * burst[i]
		f2_add[i] = burst_f2 * burst[i]
	var sub: float = shape["sub"]
	var src: PackedFloat32Array = _glottal(rng, seconds, shape, env, 0.025, 0.18, minf(sub * 1.4, 0.75), 0.04, f0_mul)
	var voice: PackedFloat32Array = _formants(src, env, shape, [1.0, 1.0, 0.85, 0.6], 0.2, f1_add, f2_add)
	# Chassis modes: high-Q resonators at circular-plate ratios over 520 Hz (decay about 25 ms).
	var chassis: PackedFloat32Array = _zeros(n)
	var ratios: Array[float] = [1.0, 1.59, 2.14, 2.30, 2.65, 2.92, 3.50]
	for k: int in ratios.size():
		var freq: float = 520.0 * ratios[k]
		_mix(chassis, _biquad(src, BANDPASS, freq, freq * PI * 0.025), 1.0 / (1.0 + 0.35 * k))
	_mix(voice, chassis, 0.55 * _rms(voice) / maxf(_rms(chassis), 1e-9))
	# Grille rattle: band-passed noise that buzzes only on the loud parts, fluttering at the roughness rate.
	var rattle: PackedFloat32Array = _zeros(n)
	var rough_hz: float = shape["rough_hz"]
	var env_top: float = _peak(env)
	for i: int in n:
		var gate: float = clampf((env[i] / env_top - 0.55) / 0.45, 0.0, 1.0)
		var flutter: float = 1.0 if sin(TAU * rough_hz * 2.0 * i / DETAIL_RATE) > 0.2 else 0.25
		rattle[i] = rng.randf_range(-1.0, 1.0) * gate * flutter
	rattle = _biquad(rattle, BANDPASS, 3200.0, 2.5)
	if _rms(rattle) > 0.0:
		_mix(voice, rattle, float(contour["rattle"]) * _rms(voice) / _rms(rattle))
	# An over-driven voice coil: asymmetric clipping adds even harmonics.
	voice = _soft_clip(_normalised(voice), 2.2, 0.2)
	# Snarl air: the voice's own 1.6-4.5 kHz band, added only inside the bursts.
	var air_amount: float = contour["air"]
	if air_amount > 0.0:
		var air: PackedFloat32Array = _biquad(_biquad(voice, HIGHPASS, 1600.0, 0.7071), HIGHPASS, 1600.0, 0.7071)
		air = _biquad(_biquad(air, LOWPASS, 4500.0, 0.7071), LOWPASS, 4500.0, 0.7071)
		for i: int in n:
			air[i] *= burst[i]
		_mix(voice, air, air_amount)
	var crushed: PackedFloat32Array = _crush(voice, 7, 1)
	for i: int in n:
		voice[i] = lerpf(voice[i], crushed[i], 0.12)
	var post_gain: PackedFloat32Array = _zeros(n)
	for i: int in n:
		post_gain[i] = pow(10.0, (gain_db[i] - top) * post / 20.0)
	return _growl_finish(voice, 50.0, 7500.0, 2800.0, 5.0, 2.4, post_gain)


## The glottal excitation: a differentiated Rosenberg pulse train following the f0 contour, with
## per-pulse jitter (period) and shimmer (amplitude), alternate-pulse period doubling for
## [param subharmonic], random period jumps with probability [param chaos] per pulse, breath noise
## gated by the flow and 20-40 Hz roughness AM; all scaled by [param env].
static func _glottal(rng: RandomNumberGenerator, seconds: float, shape: Dictionary, env: PackedFloat32Array, jitter: float, shimmer: float, subharmonic: float, chaos: float, f0_mul: PackedFloat32Array) -> PackedFloat32Array:
	var frames: int = env.size()
	var out: PackedFloat32Array = _zeros(frames)
	var dt: float = 1.0 / DETAIL_RATE
	var f0: Array = shape["f0"]
	var breath: float = shape["breath"]
	var rough_hz: float = shape["rough_hz"]
	var rough: float = shape["rough"]
	var phase: float = 0.0
	var freq: float = f0[0]
	var amp: float = 1.0
	var pulse: int = 0
	var prev: float = 0.0
	var am_phase: float = rng.randf() * TAU
	var drift: float = 0.0
	for i: int in frames:
		var t: float = i * dt
		var flow: float = _rosenberg(phase) * amp
		var dflow: float = (flow - prev) * DETAIL_RATE / freq
		prev = flow
		# The roughness rate wanders a few hertz so the flutter never sounds like a fixed LFO.
		drift += (rng.randf_range(-6.0, 6.0) - drift) * 0.0004
		am_phase += TAU * (rough_hz + drift) * dt
		var am: float = 1.0 - rough * (0.5 + 0.5 * sin(am_phase))
		var noise: float = rng.randf_range(-1.0, 1.0)
		out[i] = (dflow * 0.25 + noise * breath * (0.2 + flow)) * am * env[i]
		phase += freq * dt
		if phase >= 1.0:
			phase -= 1.0
			pulse += 1
			freq = _growl_pitch(f0, t / seconds) * (1.0 + jitter * rng.randfn()) * f0_mul[i]
			amp = maxf(0.2, 1.0 + shimmer * rng.randfn())
			if subharmonic > 0.0 and pulse % 2 == 1:
				freq *= 1.0 - 0.12 * subharmonic
				amp *= 1.0 - 0.6 * subharmonic
			if chaos > 0.0 and rng.randf() < chaos * env[i]:
				freq *= rng.randf_range(0.75, 1.3)
	return out


## Rosenberg's glottal flow pulse over one period: a 36% opening, a 19% closing, then closed.
static func _rosenberg(phase: float) -> float:
	const OPEN: float = 0.36
	const CLOSE: float = 0.19
	if phase < OPEN:
		return 0.5 - 0.5 * cos(PI * phase / OPEN)
	if phase < OPEN + CLOSE:
		return cos(0.5 * PI * (phase - OPEN) / CLOSE)
	return 0.0


## Parallel formant bank (F1-F4 band-passes with [param gains]) plus a low body band. F1 and F2
## open with the envelope and the mouth opening, and follow [param f1_add] / [param f2_add].
static func _formants(src: PackedFloat32Array, env: PackedFloat32Array, shape: Dictionary, gains: Array, body: float, f1_add: PackedFloat32Array, f2_add: PackedFloat32Array) -> PackedFloat32Array:
	var open: float = shape["open"]
	var f1: PackedFloat32Array = _zeros(src.size())
	var f2: PackedFloat32Array = _zeros(src.size())
	for i: int in src.size():
		f1[i] = 360.0 + 240.0 * open * (0.4 + 0.6 * env[i])
		f2[i] = 1150.0 + 320.0 * open * (0.5 + 0.5 * env[i])
		f1[i] += f1_add[i]
		f2[i] += f2_add[i]
	var out: PackedFloat32Array = _swept_biquad(src, BANDPASS, f1, 4.5)
	for i: int in out.size():
		out[i] *= gains[0]
	_mix(out, _swept_biquad(src, BANDPASS, f2, 6.0), gains[1])
	_mix(out, _biquad(src, BANDPASS, 2190.0, 8.0), gains[2])
	_mix(out, _biquad(src, BANDPASS, 3060.0, 8.0), gains[3])
	# Chest body around the 2nd-3rd harmonics; the fundamental itself is left to headphones.
	_mix(out, _biquad(src, BANDPASS, 190.0, 0.9), body)
	return out


## A quadratic through the three f0 points at progress [param p].
static func _growl_pitch(points: Array, p: float) -> float:
	var a: float = points[0]
	var b: float = points[1]
	var c: float = points[2]
	return lerpf(lerpf(a, b, p), lerpf(b, c, p), p)


## Raised-cosine swell and die-away (ending GROWL_TAIL before the clip end) with a gentle mid swell.
static func _growl_envelope(seconds: float, shape: Dictionary) -> PackedFloat32Array:
	var out: PackedFloat32Array = _zeros(int(seconds * DETAIL_RATE))
	var attack: float = shape["attack"]
	var release: float = shape["release"]
	var end: float = seconds - GROWL_TAIL
	for i: int in out.size():
		var t: float = float(i) / DETAIL_RATE
		var rise: float = 0.5 - 0.5 * cos(PI * clampf(t / attack, 0.0, 1.0))
		var fall: float = 0.5 - 0.5 * cos(PI * clampf((end - t) / release, 0.0, 1.0))
		out[i] = rise * fall * (0.82 + 0.18 * sin(PI * clampf(t / end, 0.0, 1.0)))
	return out


## Bit-depth and sample-rate reduction relative to the clip's own peak.
static func _crush(x: PackedFloat32Array, bits: int, hold: int) -> PackedFloat32Array:
	var peak: float = _peak(x)
	var steps: float = pow(2.0, bits - 1)
	var out: PackedFloat32Array = _zeros(x.size())
	var held: float = 0.0
	for i: int in x.size():
		if i % hold == 0:
			held = roundf(x[i] / maxf(peak, 1e-9) * steps) / steps * peak
		out[i] = held
	return out


## tanh saturation with an optional bias (asymmetry, so even harmonics), DC-corrected.
static func _soft_clip(x: PackedFloat32Array, drive: float, bias: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _zeros(x.size())
	var offset: float = tanh(bias)
	for i: int in x.size():
		out[i] = (tanh(drive * x[i] + bias) - offset) / tanh(drive + bias)
	return out


## The growl's speaker-safe finish: a 4th-order high-pass, a presence peak, a low-pass, tanh glue at
## [param drive], then [param post_gain] (after the glue, so the glue cannot flatten it) and a second
## high-pass for the slow DC that curve and the asymmetric clip leave, then 4 ms / 15 ms edges.
static func _growl_finish(x: PackedFloat32Array, hp_hz: float, lp_hz: float, presence_hz: float, presence_db: float, drive: float, post_gain: PackedFloat32Array) -> PackedFloat32Array:
	var out: PackedFloat32Array = _biquad(x, HIGHPASS, hp_hz, 0.5412)
	out = _biquad(out, HIGHPASS, hp_hz, 1.3066)
	out = _biquad(out, PEAKING, presence_hz, 1.0, presence_db)
	out = _biquad(out, LOWPASS, lp_hz, 0.7071)
	out = _soft_clip(_normalised(out), drive, 0.0)
	for i: int in out.size():
		out[i] *= post_gain[i]
	out = _biquad(out, HIGHPASS, hp_hz, 0.7071)
	var fade_in: int = int(0.004 * DETAIL_RATE)
	var fade_out: int = int(0.015 * DETAIL_RATE)
	var n: int = out.size()
	for i: int in fade_in:
		out[i] *= 0.5 - 0.5 * cos(PI * i / fade_in)
	for i: int in fade_out:
		out[n - 1 - i] *= 0.5 - 0.5 * cos(PI * i / fade_out)
	return out


# --- Shared DSP for the detailed recipes ---------------------------------------------------------

static func _zeros(frames: int) -> PackedFloat32Array:
	var out: PackedFloat32Array = PackedFloat32Array()
	out.resize(frames)
	return out


static func _white(rng: RandomNumberGenerator, frames: int) -> PackedFloat32Array:
	var out: PackedFloat32Array = _zeros(frames)
	for i: int in frames:
		out[i] = rng.randf_range(-1.0, 1.0)
	return out


## Mixes [param layer] into [param out] at [param gain].
static func _mix(out: PackedFloat32Array, layer: PackedFloat32Array, gain: float) -> void:
	for i: int in mini(out.size(), layer.size()):
		out[i] += layer[i] * gain


static func _peak(x: PackedFloat32Array) -> float:
	var peak: float = 0.0
	for sample: float in x:
		peak = maxf(peak, absf(sample))
	return peak


static func _rms(x: PackedFloat32Array) -> float:
	var sum: float = 0.0
	for sample: float in x:
		sum += sample * sample
	return sqrt(sum / maxf(x.size(), 1))


static func _normalised(x: PackedFloat32Array) -> PackedFloat32Array:
	var out: PackedFloat32Array = x.duplicate()
	var peak: float = _peak(out)
	if peak > 0.0:
		var gain: float = 1.0 / peak
		for i: int in out.size():
			out[i] *= gain
	return out


## RBJ Audio EQ Cookbook coefficients [b0, b1, b2, a1, a2], normalised by a0. BANDPASS has a 0 dB
## peak; HIGHSHELF and PEAKING take [param gain_db].
static func _coeffs(kind: int, freq: float, q: float, gain_db: float) -> PackedFloat64Array:
	var w0: float = TAU * clampf(freq, 10.0, DETAIL_RATE * 0.45) / DETAIL_RATE
	var cw: float = cos(w0)
	var alpha: float = sin(w0) / (2.0 * q)
	var a: float = pow(10.0, gain_db / 40.0)
	var b0: float
	var b1: float
	var b2: float
	var a0: float = 1.0 + alpha
	var a1: float = -2.0 * cw
	var a2: float = 1.0 - alpha
	match kind:
		LOWPASS:
			b0 = (1.0 - cw) * 0.5
			b1 = 1.0 - cw
			b2 = b0
		HIGHPASS:
			b0 = (1.0 + cw) * 0.5
			b1 = -(1.0 + cw)
			b2 = b0
		BANDPASS:
			b0 = alpha
			b1 = 0.0
			b2 = -alpha
		PEAKING:
			b0 = 1.0 + alpha * a
			b1 = -2.0 * cw
			b2 = 1.0 - alpha * a
			a0 = 1.0 + alpha / a
			a2 = 1.0 - alpha / a
		_:
			var sa: float = 2.0 * sqrt(a) * alpha
			b0 = a * ((a + 1.0) + (a - 1.0) * cw + sa)
			b1 = -2.0 * a * ((a - 1.0) + (a + 1.0) * cw)
			b2 = a * ((a + 1.0) + (a - 1.0) * cw - sa)
			a0 = (a + 1.0) - (a - 1.0) * cw + sa
			a1 = 2.0 * ((a - 1.0) - (a + 1.0) * cw)
			a2 = (a + 1.0) - (a - 1.0) * cw - sa
	return PackedFloat64Array([b0 / a0, b1 / a0, b2 / a0, a1 / a0, a2 / a0])


## A biquad (direct form I) over the whole buffer.
static func _biquad(input: PackedFloat32Array, kind: int, freq: float, q: float, gain_db: float = 0.0) -> PackedFloat32Array:
	var c: PackedFloat64Array = _coeffs(kind, freq, q, gain_db)
	var b0: float = c[0]
	var b1: float = c[1]
	var b2: float = c[2]
	var a1: float = c[3]
	var a2: float = c[4]
	var out: PackedFloat32Array = _zeros(input.size())
	var x1: float = 0.0
	var x2: float = 0.0
	var y1: float = 0.0
	var y2: float = 0.0
	for i: int in input.size():
		var x: float = input[i]
		var y: float = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2
		x2 = x1
		x1 = x
		y2 = y1
		y1 = y
		out[i] = y
	return out


## A biquad whose centre follows [param freqs] (coefficients refreshed every 16 samples).
static func _swept_biquad(input: PackedFloat32Array, kind: int, freqs: PackedFloat32Array, q: float) -> PackedFloat32Array:
	var c: PackedFloat64Array
	var out: PackedFloat32Array = _zeros(input.size())
	var x1: float = 0.0
	var x2: float = 0.0
	var y1: float = 0.0
	var y2: float = 0.0
	for i: int in input.size():
		if i % 16 == 0:
			c = _coeffs(kind, freqs[i], q, 0.0)
		var x: float = input[i]
		var y: float = c[0] * x + c[1] * x1 + c[2] * x2 - c[3] * y1 - c[4] * y2
		x2 = x1
		x1 = x
		y2 = y1
		y1 = y
		out[i] = y
	return out


## Normalises to PEAK and packs little-endian signed 16-bit mono at [param rate].
static func _wav(samples: PackedFloat32Array, loop: bool, rate: int = MIX_RATE) -> AudioStreamWAV:
	var peak: float = 0.0
	for sample: float in samples:
		if not is_finite(sample):
			push_error("SfxBank produced a non-finite sample")
			return AudioStreamWAV.new()
		peak = maxf(peak, absf(sample))
	var gain: float = PEAK / peak if peak > 0.0 else 0.0
	var bytes: PackedByteArray = PackedByteArray()
	bytes.resize(samples.size() * 2)
	for i: int in samples.size():
		bytes.encode_s16(i * 2, int(clampf(samples[i] * gain, -1.0, 1.0) * 32767.0))
	var wav: AudioStreamWAV = AudioStreamWAV.new()
	wav.format = AudioStreamWAV.FORMAT_16_BITS
	wav.mix_rate = rate
	wav.stereo = false
	wav.data = bytes
	if loop:
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = samples.size()
	return wav


## The loudest sample of a 16-bit clip as a 0..1 fraction, for tests and tuning.
static func peak_of(wav: AudioStreamWAV) -> float:
	var peak: int = 0
	var data: PackedByteArray = wav.data
	for i: int in range(0, data.size(), 2):
		peak = maxi(peak, absi(data.decode_s16(i)))
	return float(peak) / 32767.0
