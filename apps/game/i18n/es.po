#: scripts/story_text.gd:258
msgid "WOLF wouldn't draw it, so {name} timed the drop alone."
msgstr "WOLF no quiso atraerlo, así que {name} calculó la caída sin ayuda."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: An end-card row. {name} is the engineer's first name; keep {name} as written. Avoid a past tense with the engineer as its subject ("timed"): rephrase.
#. i18n: story speaker=narrator engineer=name
#: scripts/story_text.gd:261
msgid "WOLF held back while {name} timed the drop."
msgstr "WOLF se quedó atrás mientras {name} calculaba la caída."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: An end-card row. {name} is the engineer's first name; keep {name} as written. Avoid a past tense with the engineer as its subject ("timed"): rephrase.
#. i18n: story speaker=narrator engineer=name
