msgid "Go to the coolant relay. WOLF is ready for the contact."
msgstr "Va au relais de refroidissement. WOLF peut prendre le contact."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5427
msgid "Return to the breaker and arm power."
msgstr "Retourne au disjoncteur et mets le courant."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5428
msgid "Find the breaker. WOLF will follow your lead."
msgstr "Trouve le disjoncteur. WOLF te suivra."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps). The relief vent under a floor grate.
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5451
msgid "The vent is about to blow. Get off the grate now."
msgstr "L'évent va sauter. Quitte la grille maintenant."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5451
msgid "Relief vent. Get off the grate before the gauge peaks."
msgstr "Évent de décharge. Quitte la grille avant que la jauge culmine."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps). %s is the key, button or touch word the player uses (it is filled in after translation); keep it first and keep the colon.
#. i18n: speaker=hint engineer=you slot=key
#: scripts/main.gd:5455
#, c-format
msgid "%s: arm the overload breaker."
msgstr "%s : arme le disjoncteur de surcharge."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps). %s is the key, button or touch word the player uses (it is filled in after translation); keep it first and keep the colon.
#. i18n: speaker=hint engineer=you slot=key
#: scripts/main.gd:5457
#, c-format
msgid "%s: reset the breaker. The vent let go."
msgstr "%s : réarme le disjoncteur. L'évent vient de lâcher."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps). The line is the pressure line.
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5459
msgid "The line is live. Get to the valve by the door."
msgstr "La ligne est active. Va à la vanne près de la porte."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps). %s is the key, button or touch word the player uses (it is filled in after translation); keep it first and keep the colon. %d of %d: turns so far and turns needed.
#. i18n: speaker=hint engineer=you slot=key
#: scripts/main.gd:5461
#, c-format
msgid "%s: crank the valve, %d of %d turns."
msgstr "%s : tourne la vanne, %d tours sur %d."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:5463
#: scripts/story_text.gd:137
msgid "Fuse lit. Get clear of the door."
msgstr "La mèche brûle. Éloigne-toi de la porte."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5465
msgid "The valve is dead. Arm the breaker by the entrance."
msgstr "La vanne est hors tension. Arme le disjoncteur à l'entrée."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint
#: scripts/main.gd:5467
msgid "Relief vent. It lets go when the gauge peaks."
msgstr "Évent de décharge. Il lâche quand la jauge culmine."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps). The line is building pressure.
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5470
msgid "The line is building. Crank the valve by the door."
msgstr "La ligne monte en pression. Tourne la vanne près de la porte."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5472
msgid "The breaker tripped. Reset it by the entrance."
msgstr "Le disjoncteur vient de sauter. Réarme-le à l'entrée."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5474
msgid "Arm the breaker by the entrance, then crank the valve by the door."
msgstr "Arme le disjoncteur à l'entrée, puis tourne la vanne près de la porte."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5474
msgid "Get through the sealed door."
msgstr "Passe la porte étanche."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint
#: scripts/main.gd:5495
msgid "The door is open."
msgstr "La porte est ouverte."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps). %s is the key, button or touch word the player uses (it is filled in after translation); keep it first and keep the colon. Release the bolt that locks the exit door.
#. i18n: speaker=hint engineer=you slot=key
#: scripts/main.gd:5500
#, c-format
msgid "%s: pop the exit bolt."
msgstr "%s : fais sauter le verrou de sortie."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:5502
#: scripts/story_text.gd:200
msgid "The bolt is taking the charge."
msgstr "Le verrou reçoit la charge."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint
#: scripts/main.gd:5504
#: scripts/main.gd:5508
msgid "The door is opening."
msgstr "La porte s'ouvre."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps). %s is the key, button or touch word the player uses (it is filled in after translation); keep it first and keep the colon.
#. i18n: speaker=hint engineer=you slot=key
#: scripts/main.gd:5506
#, c-format
msgid "%s: leave through the door."
msgstr "%s : sors par la porte."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5506
#: scripts/main.gd:5509
msgid "The door is open. Leave through it."
msgstr "La porte est ouverte. Sors par là."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps). The sentry is a robot (it).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5509
msgid "The sentry is down. Pop the exit bolt by the door."
msgstr "La sentinelle est à terre. Fais sauter le verrou de sortie près de la porte."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:5511
