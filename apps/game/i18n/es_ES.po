#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3283
msgid "No station in reach. The breaker is by the entrance, the valve by the door."
msgstr "No hay estaciones al alcance. El disyuntor está en la entrada; la válvula, junto a la puerta."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3455
msgid "The clamp lets go."
msgstr "La pinza se suelta."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3546
msgid "SERVICE LINE CLEARED."
msgstr "LÍNEA DE SERVICIO DESPEJADA."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=WOLF
#: scripts/main.gd:3548
msgid "It's quiet now. The line runs on toward Archive."
msgstr "Ahora hay silencio. La línea sigue hacia el Archivo."

