#: scripts/m0_state.gd:199
#, c-format
msgid ""
"You said \"%s\"\n"
"I chose the relay. We made it."
msgstr ""
"Twoje słowa: „%s”\n"
"Wybrałem przekaźnik. Udało się nam."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: WOLF's callback at the safe point. %s is the answer the engineer chose at the relay, as the game shows it; keep the quotation marks round it in your language's style. Avoid a past tense that shows the engineer's gender ("you said", "you cranked").
#. i18n: story speaker=WOLF engineer=you slot=choice keep-breaks
#: scripts/m0_state.gd:203
#, c-format
msgid ""
"You said \"%s\"\n"
"I made my call. You cranked the bypass anyway. I stayed."
msgstr ""
"Twoje słowa: „%s”\n"
"Podjąłem decyzję. A obejście i tak ruszyło, twoją ręką. Zostałem."

