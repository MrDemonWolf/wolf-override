# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Open glossary term SERVICE JUNCTION: węzeł serwisowy, the room card's WĘZEŁ SERWISOWY; a reviewer's word.
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2520
msgid ""
"Service junction restored. The sentry\n"
"is down; pop the exit bolt by the door."
msgstr "Węzeł serwisowy przywrócony. Strażnik leży; zwolnij rygiel wyjścia przy drzwiach."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Open glossary term SERVICE JUNCTION: węzeł serwisowy, the room card's WĘZEŁ SERWISOWY; a reviewer's word.
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2523
msgid ""
"Service junction restored. The door is\n"
"down. The sentry patrols past the rubble."
msgstr "Węzeł serwisowy przywrócony. Drzwi wysadzone. Strażnik patroluje za gruzowiskiem."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2529
msgid "The first copy is safe. Use the exit to follow the service line."
msgstr "Pierwsza kopia jest bezpieczna. Skorzystaj z wyjścia, by iść wzdłuż linii serwisowej."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2532
msgid "Records access restored. Both traces are copied; head for the exit."
msgstr "Dostęp do rejestrów przywrócony. Oba ślady skopiowane; ruszaj do wyjścia."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2535
msgid "Records access restored. The purge order is copied; copy the mirror index next."
msgstr "Dostęp do rejestrów przywrócony. Rozkaz czystki skopiowany; teraz skopiuj indeks lustra."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2538
msgid "Records access restored. Copy the purge-order trace first; WOLF is checking the mirror."
msgstr "Dostęp do rejestrów przywrócony. Najpierw skopiuj ślad rozkazu czystki; WOLF sprawdza lustro."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2542
msgid "Safe point restored."
msgstr "Schron przywrócony."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: The Director's purge display, read as a speaker; WOLF answers in the next message. The records worker is the witness; no gendered form for them.
#. i18n: story speaker=DIRECTOR
#: scripts/main.gd:2573
msgid "Records worker's archive marked for deletion."
msgstr "Zbiory osoby z archiwum oznaczone do usunięcia."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=WOLF
#: scripts/main.gd:2575
msgid "They want the source record gone. We need to preserve it."
msgstr "Chcą, żeby źródłowy zapis zniknął. Musimy go zachować."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2586
msgid "No station in reach. Follow the labeled breaker, relay, bypass or safe point."
msgstr "Żadnej stacji w zasięgu. Idź do oznaczonego wyłącznika, przekaźnika, obejścia albo schronu."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2627
msgid "Power is already on. The relay is farther down the hall."
msgstr "Zasilanie już jest. Przekaźnik jest dalej w korytarzu."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: WOLF thanks the engineer for telling him the relay's risk. Avoid a past tense that shows the engineer's gender ("you told me").
#. i18n: story speaker=WOLF engineer=you
#: scripts/main.gd:2640
msgid "Thank you for telling me. I'll take the relay. Arm the breaker."
msgstr "Dziękuję, że mi to mówisz. Biorę przekaźnik. Załącz wyłącznik."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=WOLF
#: scripts/main.gd:2644
msgid "No. I won't take that risk blind. Use the manual bypass."
msgstr "Nie. Nie podejmę tego ryzyka w ciemno. Użyj ręcznego obejścia."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2657
msgid "The relay is dark. Arm the breaker first."
msgstr "Przekaźnik jest bez zasilania. Najpierw załącz wyłącznik."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2661
#: scripts/main.gd:2704
msgid "The seal is open. The safe point is just beyond it."
msgstr "Śluza jest otwarta. Schron jest tuż za nią."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=WOLF
#: scripts/main.gd:2667
msgid "I said no. I won't touch it blind. The bypass is right beside it."
msgstr "Powiedziałem: nie. Nie dotknę go w ciemno. Obejście jest tuż obok."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=WOLF
#: scripts/main.gd:2679
msgid "I've got the contact. Give me a moment."
msgstr "Mam styk. Daj mi chwilę."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2691
msgid "WOLF takes the surge through the live contact. The red seal opens."
msgstr "WOLF przyjmuje przepięcie przez styk pod napięciem. Czerwona śluza się otwiera."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2707
msgid "The bypass handle won't move. The breaker has to be on first."
msgstr "Dźwignia obejścia ani drgnie. Najpierw musi być załączony wyłącznik."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2764
msgid "The bypass locks over and the alarm cuts out. The red seal opens."
msgstr "Obejście się zatrzaskuje, a alarm milknie. Czerwona śluza się otwiera."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=WOLF
#: scripts/main.gd:2766
msgid "Open. I'm with you."
msgstr "Otwarte. Jestem z tobą."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2777
msgid "The safe point is past the sealed door."
msgstr "Schron jest za zamkniętą śluzą."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: WOLF, after the engineer pressed him at the relay without warning.
#. i18n: story speaker=WOLF
#: scripts/main.gd:2791
msgid "I refused the live relay; I'm still here."
msgstr "Odmówiłem pracy przy przekaźniku pod napięciem; wciąż tu jestem."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: WOLF to the engineer, who told him the relay's risk. Avoid a past tense that shows the engineer's gender ("you told me").
#. i18n: story speaker=WOLF engineer=you
#: scripts/main.gd:2794
msgid "I took the relay because you told me the truth."
msgstr "Wziąłem przekaźnik dzięki twojej szczerości."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: WOLF to the engineer, who cranked the manual bypass after he offered to take the relay. Avoid a past tense that shows the engineer's gender ("you cranked").
#. i18n: story speaker=WOLF engineer=you
#: scripts/main.gd:2797
msgid "I offered the relay; you cranked the bypass. Still with you."
msgstr "Zaoferowałem przekaźnik; obejście poszło w ruch dzięki tobie. Wciąż jestem z tobą."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=WOLF
#: scripts/main.gd:2800
msgid "Take the purge queue. I'll inspect the mirror."
msgstr "Weź kolejkę czystki. Ja sprawdzę lustro."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps). %s is the key or button.
#. i18n: speaker=hint engineer=you slot=key
#: scripts/main.gd:2809
#, c-format
msgid "The safe point could not save. Press %s here again."
msgstr "Błąd zapisu w schronie. Jeszcze raz naciśnij tu %s."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps). The touch form; USE is the touch button's word (UŻYĆ), named as 'przycisk UŻYĆ'.
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:2809
msgid "The safe point could not save. Tap USE here again."
msgstr "Błąd zapisu w schronie. Dotknij tu ponownie przycisku UŻYĆ."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2820
msgid "Safe point saved."
msgstr "Zapisano w schronie."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2823
msgid "Safe point saved. WOLF remembers the same choice."
msgstr "Zapisano w schronie. WOLF pamięta ten sam wybór."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: %s is the engineer's first name. The worker is the records worker, the witness; no gendered form for them.
#. i18n: story speaker=narrator engineer=name
#: scripts/main.gd:2832
#, c-format
msgid "The Director's purge order has a time and file ID. %s keeps a local copy; the worker's originals are still missing."
msgstr "Rozkaz czystki Dyrektora ma czas i ID pliku. %s zachowuje lokalną kopię; oryginałów osoby z archiwum wciąż brak."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2835
msgid "The purge-order trace is already copied. The mirror port may confirm when the source existed."
msgstr "Ślad rozkazu czystki jest już skopiowany. Port lustra może potwierdzić, kiedy źródło istniało."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2841
msgid "The mirror index has no context yet. Copy the purge-order trace first."
msgstr "Indeks lustra nie ma jeszcze kontekstu. Najpierw skopiuj ślad rozkazu czystki."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2844
msgid "The mirror timestamp is already preserved. The exit is to the right."
msgstr "Znacznik czasu lustra jest już zachowany. Wyjście jest po prawej."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=WOLF
#: scripts/main.gd:2853
msgid "I found the mirror index. We can use my readout or your maintenance port."
msgstr "Znalazłem indeks lustra. Możemy użyć mojego odczytu albo twojego portu serwisowego."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:2882
msgid "Exit sealed until the purge order and mirror timestamp are copied."
msgstr "Wyjście zamknięte, dopóki rozkaz czystki i znacznik czasu lustra nie zostaną skopiowane."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:2919
#: scripts/main.gd:5383
msgid "Mirror copied. Head for the exit."
msgstr "Lustro skopiowane. Kieruj się do wyjścia."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:2921
msgid "Follow the station lights: mirror port, then exit."
msgstr "Idź za światłami stacji: port lustra, potem wyjście."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:2922
msgid "Follow the station lights: purge queue, mirror port, then exit."
msgstr "Idź za światłami stacji: kolejka czystki, port lustra, potem wyjście."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: WOLF's line in the dialogue box (after the WOLF: tag). %s is the second answer's key or button.
#. TRANSLATORS: WOLF, still walking to the mirror. %s is the key or button for the manual port.
#. i18n: story speaker=WOLF slot=key
#: scripts/main.gd:3138
#, c-format
msgid "I'm still checking the drive. Wait for me, or press %s for the manual port."
msgstr "Wciąż sprawdzam dysk. Zaczekaj na mnie albo naciśnij %s i użyj portu ręcznego."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: WOLF, still walking to the mirror, touch form. USE MANUAL PORT is the answer button's text: use its translation here.
#. i18n: story speaker=WOLF
#: scripts/main.gd:3141
msgid "I'm still checking the drive. Wait for me, or tap USE MANUAL PORT."
msgstr "Wciąż sprawdzam dysk. Zaczekaj na mnie albo dotknij „UŻYĆ PORTU RĘCZNEGO”."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: The worker is the records worker, the witness; no gendered form for them.
#. i18n: story speaker=narrator
#: scripts/main.gd:3154
msgid "WOLF reads the timestamp off his own readout. The worker's files existed before the deletion order."
msgstr "WOLF bierze znacznik czasu z własnego odczytu. Pliki osoby z archiwum istniały przed rozkazem usunięcia."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: %s is the engineer's first name.
#. i18n: story speaker=narrator engineer=name
#: scripts/main.gd:3158
#, c-format
msgid "%s copies the timestamp through the maintenance port. WOLF keeps watch."
msgstr "%s kopiuje znacznik czasu przez port serwisowy. WOLF czuwa."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Hint bar (14 px, about 526 px wide on a keyboard and 488 px on touch; wraps).
#. i18n: speaker=hint engineer=you
#: scripts/main.gd:3174
msgid "Save failed. Use a station to try again."
msgstr "Nie udało się zapisać. Użyj stacji, by spróbować ponownie."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3244
msgid "The overload breaker catches and the line starts to build. If the LINE gauge peaks, the relief vent lets go."
msgstr "Wyłącznik przeciążeniowy zaskakuje i ciśnienie w linii zaczyna rosnąć. Jeśli wskaźnik LINIA dojdzie do szczytu, upust ciśnienia puści."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3259
msgid "The wheel is stiff. Three full turns charge the door."
msgstr "Koło chodzi ciężko. Trzy pełne obroty ładują drzwi."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3268
msgid "Relief vent. It lets go when the gauge peaks; don't be standing on it."
msgstr "Upust ciśnienia. Puszcza, gdy wskaźnik dojdzie do szczytu; nie stój na nim."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3277
msgid ""
"No station in reach. The exit bolt is\n"
"by the door."
msgstr "Żadnej stacji w zasięgu. Rygiel wyjścia jest przy drzwiach."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3280
msgid ""
"No station in reach. The TANK RELEASE\n"
"is past the rubble."
msgstr "Żadnej stacji w zasięgu. „ZRZUT ZBIORNIKA” jest za gruzowiskiem."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3283
msgid "No station in reach. The breaker is by the entrance, the valve by the door."
msgstr "Żadnej stacji w zasięgu. Wyłącznik jest przy wejściu, zawór przy drzwiach."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3455
msgid "The clamp lets go."
msgstr "Zacisk puszcza."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3546
msgid "SERVICE LINE CLEARED."
msgstr "LINIA SERWISOWA OCZYSZCZONA."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=WOLF
#: scripts/main.gd:3548
msgid "It's quiet now. The line runs on toward Archive."
msgstr "Teraz jest cicho. Linia biegnie dalej, do Archiwum."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=engineer engineer=self
#: scripts/main.gd:3550
msgid "Then that's where we go."
msgstr "To tam idziemy."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=WOLF
#: scripts/main.gd:3814
msgid "It passes under that tank on every patrol. How do we bring it down?"
msgstr "Przy każdym obchodzie przechodzi pod tym zbiornikiem. Jak go powalimy?"

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3928
msgid "The winch has the tank back on the clamp. The TANK RELEASE is ready again."
msgstr "Wciągarka znów trzyma zbiornik na zacisku. „ZRZUT ZBIORNIKA” znów jest gotowy."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3960
msgid "FUSE LIT. Back away from the door, past the valve."
msgstr "LONT ZAPALONY. Odsuń się od drzwi, za zawór."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: The valve's turns so far and the turns needed (3).
#. i18n: story speaker=narrator
#: scripts/main.gd:3964
#, c-format
msgid "The valve gives. %d of %d turns."
msgstr "Zawór ustępuje. %d z %d obrotów."

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: i18n: story speaker=narrator
#: scripts/main.gd:3984
msgid "The relief vent lets go and the breaker trips. Reset the breaker and crank faster this time."
msgstr "Upust ciśnienia puszcza, a wyłącznik się wybija. Zresetuj wyłącznik i tym razem kręć szybciej."

