msgstr "ВЫХОД ОТКРЫТ"

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Station plate (12-13 px label on a machine). ALL CAPS, as short as possible. The junction's exit hatch while it slides open.
#. i18n: speaker=ui
#: scripts/junction_room.gd:1583
msgid "EXIT OPENING"
msgstr "ВЫХОД ОТКРЫВАЕТСЯ"

# machine-translated by Claude (Anthropic), unreviewed
#. TRANSLATORS: Station plate (12-13 px label on a machine). ALL CAPS, as short as possible. The junction's exit hatch, ready to open.
#. i18n: speaker=ui
#: scripts/junction_room.gd:1586
