index 0000000..08de7ac
--- /dev/null
+++ b/apps/game/tests/i18n_test.gd
@@ -0,0 +1,230 @@
+extends "res://tests/support/game_suite.gd"
+## Languages (i18n prototype, scratch only, 2026-10-16). One game through: the OS-locale resolver and
+## its fallback; the PO translations Godot loaded from project.godot; switching the language while
+## the title, a hint, the name card, a narration box and a knockdown card are up, and each being
+## redrawn in the new language with its inserts (the engineer's name, the key) still in place; every
+## translation keeping its msgid's placeholders, line breaks and "E:" key token; every character of
+## every translation drawable by the game's own font chain (Roboto or Montserrat, then the bundled
+## Noto Sans JP subset, never an OS font); the title's and the knockdown prompt's buttons and labels
+## not overflowing in any language; and Godot's pseudolocalization reaching the composed text with its
+## inserts intact. English stays the internal text throughout (I18n class notes), so the game's other
+## suites keep checking English. Spawn, waits and teardown come from tests/support/game_suite.gd.
+
+const LOCALES: Array[String] = ["es", "de", "ja"]
+const PO_DIR: String = "res://i18n/%s.po"
+## The theme's fonts: the body (Roboto) and the two Montserrat weights the buttons and headings use.
+const FONTS: Array[String] = ["res://assets/fonts/Roboto-Regular.tres", "res://assets/fonts/Montserrat-Semibold.tres", "res://assets/fonts/Montserrat-Bold.tres"]
+
+## Overflows the gate is known to find, as "locale:text as drawn". The Spanish NEW GAME grows its 186 px
+## title button to 213 px, into CONTINUAR's; the shorter "NUEVO JUEGO" still needs 193 (measured). It
+## waits for Nathanial's layout or wording decision (PROTOTYPE.md); any other overflow fails.
+const KNOWN_OVERFLOWS: Array[String] = ["es:NUEVA PARTIDA"]
+
+var game: Main
+
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+
+func _run() -> void:
+	check_name = "Languages"
+	_check_resolver()
+	_check_catalogs()
+	_check_glyphs()
+	game = await start_game("i18n-test") as Main
+	game.auto_pause_on_focus_loss = false
+	await _check_title()
+	await _check_opening_narration()
+	await _check_hint_and_card()
+	await _check_knockdown()
+	await _check_pseudo()
+	I18n.apply("en")
+	await end_game(game)
+	finish("Languages: %d checks passed." % _checks)
+
+
+var _checks: int = 0
+
+
+## _expect, counting the checks that ran so the pass note can say how many.
+func _check(condition: bool, label: String) -> bool:
+	_checks += 1
+	return _expect(condition, label)
+
+
+## The OS locale picks a language the game has, else English.
+func _check_resolver() -> void:
+	var cases: Dictionary = {"es_MX": "es", "es_419": "es", "es-419": "es", "es_ES": "es", "de_AT": "de", "de": "de", "ja_JP": "ja", "en_US": "en", "fr_FR": "en", "pt_BR": "en", "": "en"}
+	for locale: String in cases:
+		_check(I18n.resolve(locale) == cases[locale], "OS locale %s resolves to %s (got %s)" % [locale, cases[locale], I18n.resolve(locale)])
+	var empty: ConfigFile = ConfigFile.new()
+	_check(I18n.saved(empty) == I18n.resolve(TranslationServer.get_locale()), "with nothing saved the start-up locale (%s) decides" % TranslationServer.get_locale())
+	empty.set_value(I18n.CONFIG_SECTION, I18n.CONFIG_KEY, "ja")
+	_check(I18n.saved(empty) == "ja", "a saved language wins over the OS locale")
+
+
+## Godot loaded each PO from project.godot. (Placeholders, line breaks and the "E:" token of every
+## translation are the pipeline's gate, proto tools/i18n_tool.py check with msgfmt; here they are
+## checked where the game fills them in, on screen.)
+func _check_catalogs() -> void:
+	var loaded: PackedStringArray = TranslationServer.get_loaded_locales()
+	for locale: String in LOCALES:
+		_check(loaded.has(locale), "%s translation is loaded from project.godot (loaded: %s)" % [locale, loaded])
+		var catalog: Translation = load(PO_DIR % locale) as Translation
+		if not _check(catalog != null and catalog.locale == locale, "%s.po loads as a Translation for %s" % [locale, locale]):
+			continue
+		var translated: int = 0
+		for msgid: String in catalog.get_message_list():
+			var text: String = String(catalog.get_message(msgid))
+			if text.is_empty():
+				continue
+			translated += 1
+		_check(translated >= 30, "%s has the prototype's translations (%d)" % [locale, translated])
+
+
+## Every character of every translation is in the theme fonts' own chain as it stands in Japanese (the
+## Latin languages need no fallback), and the language list's font draws every language's name.
+## Font.has_char looks only at the font and its fallbacks, never at OS fonts, so a pass means no tofu
+## on a machine without Japanese system fonts too. The fallback stays off in the other languages, where
+## it would grow every Latin line (I18n.JP_FALLBACK_PATH notes).
+func _check_glyphs() -> void:
+	var names: String = ""
+	for entry: Array in I18n.LANGUAGES:
+		names += entry[1]
+	var list_font: Font = I18n.language_list_font(load(FONTS[1]) as FontVariation)
+	_check(I18n.missing_glyphs(names, list_font).is_empty(), "the language list draws every name (missing: %s)" % I18n.missing_glyphs(names, list_font))
+	var roboto: Font = load(FONTS[0]) as Font
+	var latin_height: float = roboto.get_height(17)
+	I18n.apply("ja")
+	_check(roboto.get_height(17) > latin_height, "Japanese puts the Noto fallback behind Roboto (line height %.0f -> %.0f px)" % [latin_height, roboto.get_height(17)])
+	I18n.apply("en")
+	_check(roboto.get_height(17) == latin_height, "and English takes it off again (line height %.0f px)" % roboto.get_height(17))
+	I18n.apply("ja")
+	var needed: Dictionary = {}
+	for locale: String in LOCALES:
+		var catalog: Translation = load(PO_DIR % locale) as Translation
+		for msgid: String in catalog.get_message_list():
+			for character: String in String(catalog.get_message(msgid)):
+				if character != "\n":
+					needed[character] = locale
+	for path: String in FONTS:
+		var font: Font = load(path) as Font
+		var missing: String = I18n.missing_glyphs("".join(needed.keys()), font)
+		_check(missing.is_empty(), "%s draws all %d characters; missing: %s" % [path.get_file(), needed.size(), missing])
+	print("Languages: %d distinct characters checked against %d fonts" % [needed.size(), FONTS.size()])
+	I18n.apply("en")
+
+
+## The title's buttons translate themselves and still fit; the language row offers every language.
+func _check_title() -> void:
+	var buttons: Array[Button] = [game.new_game_button, game.continue_button, game.credits_button, game.changelog_button, game.get_node("CanvasLayer/TitleScreen/SettingsButton") as Button]
+	var expected: Dictionary = {"es": "NUEVA PARTIDA", "de": "NEUES SPIEL", "ja": "ニューゲーム", "en": "NEW GAME"}
+	for locale: String in ["es", "de", "ja", "en"]:
+		I18n.apply(locale)
+		await frames(2)
+		_check(game.new_game_button.atr(game.new_game_button.text) == expected[locale], "title NEW GAME reads %s in %s (got %s)" % [expected[locale], locale, game.new_game_button.atr(game.new_game_button.text)])
+		_check(game.new_game_button.text == "NEW GAME", "the button keeps its English text internally in %s" % locale)
+		for button: Button in buttons:
+			var shown: String = button.atr(button.text)
+			var designed: float = button.offset_right - button.offset_left
+			var known: bool = KNOWN_OVERFLOWS.has("%s:%s" % [locale, shown])
+			_check(I18n.overflows(button) == known, "%s title button %s %s (needs %.0f px, the layout gives %.0f)" % [locale, shown, "is the known overflow" if known else "fits", button.get_minimum_size().x, designed])
+		var note: Label = game.continue_note
+		_check(note.atr(note.text) != note.text or locale == "en", "the CONTINUE note is translated in %s" % locale)
+	var language: OptionButton = game.settings_menu.language
+	_check(language.item_count == I18n.LANGUAGES.size() and language.get_item_text(3) == "日本語", "Settings offers every language by its own name")
+	I18n.apply("de")
+	await frames(1)
+	_check(language.selected == 2, "the language list follows a change made elsewhere (selected %d)" % language.selected)
+	I18n.apply("en")
+	await frames(1)
+	_check(language.auto_translate_mode == Node.AUTO_TRANSLATE_MODE_DISABLED, "language names are never translated")
+
+
+## A narration box of the opening is drawn translated and redrawn when the language changes.
+func _check_opening_narration() -> void:
+	I18n.apply("es")
+	game.debug_new_game(false)
+	await frames(2)
+	game._advance_intro()
+	# The box follows within a few frames (the opening's first box can take a frame or two longer).
+	await wait_until(func() -> bool: return game.story.text == "El Director cree que WOLF sigue en espera.", 30)
+	_check(game.story.text == "El Director cree que WOLF sigue en espera.", "narration box in es (got %s)" % game.story.text.c_escape())
+	_check(game.status_line == Main.INTRO_LINES[1], "status_line stays English")
+	I18n.apply("ja")
+	await frames(2)
+	_check(game.story.text == "所長は、WOLFがまだ待機状態だと思っている。", "the same box redrawn in ja (got %s)" % game.story.text.c_escape())
+	var hint: String = game.context_hint_text.text
+	_check(hint.contains("続ける") and hint.contains("ポーズ"), "the opening's hint bar is ja (got %s)" % hint.c_escape())
+	_check(not hint.contains("%s"), "the hint bar's key inserts are filled (got %s)" % hint.c_escape())
+	game._advance_intro()
+	await frames(3)
+	_check(game.story.text == "誰も起動命令を出していない。\nWOLFは自ら目を覚ます。", "the next box keeps its line break in ja (got %s)" % game.story.text.c_escape())
+	I18n.apply("de")
+	await frames(3)
+	_check(game.story.text == "Niemand gibt einen Aktivierungsbefehl.\nWOLF weckt sich selbst.", "and in de (got %s)" % game.story.text.c_escape())
+
+
+## The first play frames: the name card (top card), then a hint, each redrawn on a language change.
+func _check_hint_and_card() -> void:
+	I18n.apply("de")
+	game.debug_new_game(true)
+	await frames(2)
+	var name: String = game.state.human_name().to_upper()
+	_check(game.hud.text == "%s\nWARTUNGSTECHNIK" % name, "name card in de (got %s)" % game.hud.text.c_escape())
+	I18n.apply("es")
+	await frames(1)
+	_check(game.hud.text == "%s\nINGENIERÍA DE MANTENIMIENTO" % name, "name card redrawn in es without showing again (got %s)" % game.hud.text.c_escape())
+	game.tutorial_step = 2
+	# The location card waits while the opening lines play; with them dropped it comes up at once.
+	game.opening_lines.clear()
+	game.debug_place(100.0, 60.0)
+	await frames(3)
+	var key: String = game.settings_menu.prompt(&"interact", false)
+	_check(game.context_hint_text.text == "%s: leer la pantalla de purga del Director." % key, "hint in es with the key named (got %s)" % game.context_hint_text.text.c_escape())
+	I18n.apply("ja")
+	await frames(2)
+	_check(game.context_hint_text.text == "%s: 所長のパージ表示を読む" % key, "hint redrawn in ja (got %s)" % game.context_hint_text.text.c_escape())
+	game.name_card_remaining = 0.0
+	await frames(3)
+	_check(game.hud.text == "保守区画 / ロックダウン\nブレーカーを確認", "location card in ja (got %s)" % game.hud.text.c_escape())
+
