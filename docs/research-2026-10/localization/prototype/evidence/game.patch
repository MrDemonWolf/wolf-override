+## Godot's pseudolocalization reaches the composed text and keeps the name in it.
+func _check_pseudo() -> void:
+	I18n.apply("en")
+	for setting: String in ["replace_with_accents", "double_vowels"]:
+		ProjectSettings.set_setting("internationalization/pseudolocalization/" + setting, false)
+	ProjectSettings.set_setting("internationalization/pseudolocalization/expansion_ratio", 0.3)
+	TranslationServer.reload_pseudolocalization()
+	TranslationServer.pseudolocalization_enabled = true
+	await frames(3)
+	var first: String = game.state.human_name().get_slice(" ", 0)
+	var shown: String = " ".join(game.dialogue_boxes)
+	_check(shown.begins_with("[") and shown.ends_with("]") and shown.contains(first), "pseudolocalized knockdown card keeps the name (got %s)" % shown.c_escape())
+	_check(game.new_game_button.atr(game.new_game_button.text).begins_with("["), "title buttons are pseudolocalized")
+	TranslationServer.pseudolocalization_enabled = false
