+## A knockdown card: its template translated, the engineer's name filled in, and the RETRY prompt.
+func _check_knockdown() -> void:
+	I18n.apply("es")
+	game.debug_knock_down(&"vent")
+	await frames(3)
+	var first: String = game.state.human_name().get_slice(" ", 0)
+	var expected: String = "La válvula de alivio estalló bajo %s. Cuando el manómetro llegue al máximo, no pises la rejilla." % first
+	_check(game.status_line == JunctionRoom.VENT_REASON % first, "the knockdown line stays English internally")
+	var shown: String = " ".join(game.dialogue_boxes).replace("\n", " ")
+	_check(shown == expected, "knockdown card in es with the name (got %s)" % shown.c_escape())
+	await wait_until(func() -> bool: return game._retry_ready(), 120)
+	await frames(2)
+	var key: String = game.settings_menu.prompt(&"interact", false)
+	_check(game.context_hint_text.text == "%s  REINTENTAR" % key, "RETRY prompt in es (got %s)" % game.context_hint_text.text.c_escape())
+	I18n.apply("ja")
+	await frames(2)
+	shown = "".join(game.dialogue_boxes).replace("\n", "")
+	_check(shown == "%sの足元でリリーフベントが噴き出した。ゲージが振り切れたら、格子から離れること。" % first, "knockdown card redrawn in ja with the name (got %s)" % shown.c_escape())
+	_check(game.context_hint_text.text == "%s  リトライ" % key, "RETRY prompt in ja (got %s)" % game.context_hint_text.text.c_escape())
+	for box: String in game.dialogue_boxes:
+		_check(game._dialogue_fits(DialogueBoxes.words_of(box, game._speaker_tags())), "ja knockdown box fits two rows: %s" % box.c_escape())
+
