index 0000000..e7cf01c
--- /dev/null
+++ b/apps/game/scripts/i18n.gd
@@ -0,0 +1,195 @@
+class_name I18n
+extends RefCounted
+## The game's languages (scratch prototype of the i18n job, 2026-10-16; not on any branch).
+##
+## The rule the prototype tests: English stays the game's internal text. Constants, status_line,
+## saves, comparisons and the tests keep the English words; translation happens only where text is
+## drawn. Three ways a string reaches the screen translated:
+## - A Control whose whole text is one message keeps Godot's auto-translate (scene buttons, Settings
+##   captions): it is given the English and translates itself, also when the language changes.
+## - Text worked out every frame (hints, prompts) calls tr() where it is worked out.
+## - Text that is kept between frames (status_line, the top card, a knockdown card) stays English and is
+##   translated where it is drawn, by [method shown] and [method lines]; its Label has auto-translate
+##   off, so nothing is translated twice.
+## Godot's POT generator (proto tools/extract_pot.sh) only extracts tr()/tr_n()/atr()/atr_n() calls
+## whose argument reduces to a constant, plus scene text and literal .text assignments. English that is
+## stored first and translated later is marked with [code]I18n.KEY.tr(TEXT)[/code]: KEY is an object
+## with message translation off, so the call returns TEXT unchanged, but the generator still sees a
+## tr() of a constant and extracts it (Godot 4.7.2 modules/gdscript/editor/
+## gdscript_translation_parser_plugin.cpp matches the called method's name only).
+##
+## Gotchas:
+## - Static functions cannot call tr() (a parse error), so the statics here use
+##   TranslationServer.translate(), which the generator does not extract: never pass a literal to them.
+## - A formatted line ("... %s ...") can only be translated from its template, so lines with inserts
+##   are built with [method format], which remembers the template and the inserts for [method shown].
+
+## The languages offered, in Settings order: Godot locale code, then the name in its own language.
+## "es" is Latin-American Spanish (es-419): Godot reduces es-419 to "es" (TranslationServer.
+## standardize_locale keeps only two-letter regions), so a Spain file would be "es_ES".
+const LANGUAGES: Array[Array] = [["en", "English"], ["es", "Español (Latinoamérica)"], ["de", "Deutsch"], ["ja", "日本語"]]
+## The language when the OS asks for one the game does not have.
+const FALLBACK: String = "en"
+## The Japanese fallback font: a subset of Noto Sans JP (SIL OFL 1.1, notofonts/noto-cjk Sans 2.004)
+## made by the proto tools/i18n_tool.py subset. While Japanese is the language it is put behind both
+## game fonts (Roboto and Montserrat), so any glyph they lack (kana, kanji, CJK punctuation) comes from
+## it and never from the OS. Only then: Font.get_height() is the tallest of a font's whole chain, so
+## with Noto behind it Roboto's line height grows from 21 to 25 px at 17 px (measured, Godot 4.7.2),
+## which moves every Label in English too. The language list draws "日本語" with its own chain
+## (language_list_font).
+const JP_FALLBACK_PATH: String = "res://assets/fonts/NotoSansJP-Subset.otf"
+## The game's two font files; every FontVariation in the theme uses one of them as its base, and a
+## FontVariation with no fallbacks of its own uses its base font's.
+const BASE_FONT_PATHS: Array[String] = ["res://assets/fonts/Roboto-Variable.ttf", "res://assets/fonts/Montserrat-Variable.ttf"]
+## The settings file's section and key for the chosen language (absent: follow the OS).
+const CONFIG_SECTION: String = "general"
+const CONFIG_KEY: String = "language"
+
+## Extraction marker: KEY.tr(TEXT) returns TEXT untranslated (see the class notes).
+static var KEY: Object = _make_key()
+## Template and inserts of every line built with [method format], by the finished English line.
+static var _formats: Dictionary = {}
+
+
+static func _make_key() -> Object:
+	var key: RefCounted = RefCounted.new()
+	key.set_message_translation(false)
+	return key
+
+
+## The offered language for an OS or saved locale such as "es_MX", "de_AT" or "fr_FR": its language
+## if the game has it, else FALLBACK. Every Spanish locale maps to "es" until a Spain file exists.
+static func resolve(locale: String) -> String:
+	var language: String = TranslationServer.standardize_locale(locale).get_slice("_", 0)
+	for entry: Array in LANGUAGES:
+		if entry[0] == language:
+			return language
+	return FALLBACK
+
+
+## The language in [param config] (Settings' file), or when none was chosen the locale Godot started
+## in: the OS's (OS.get_locale()), unless `--language xx` or internationalization/locale/test set
+## another (TranslationServer.setup), so tests and captures can pin a language.
+static func saved(config: ConfigFile) -> String:
+	var value: Variant = config.get_value(CONFIG_SECTION, CONFIG_KEY, "")
+	return resolve(value if value is String and not (value as String).is_empty() else TranslationServer.get_locale())
+
+
+## Switches the game to [param code] (one of LANGUAGES), with the Japanese fallback behind the game
+## fonts only for Japanese. TranslationServer then notifies every node
+## (NOTIFICATION_TRANSLATION_CHANGED); auto-translating Controls redraw themselves and Main refreshes
+## the text it keeps.
+static func apply(code: String) -> void:
+	var language: String = resolve(code)
+	use_japanese_fallback(language == "ja")
+	TranslationServer.set_locale(language)
+
+
+## Puts the Japanese fallback behind the game's font files ([param on]) or takes it off again. Changing
+## a Font's fallbacks emits its changed signal, so every Control using it lays itself out again.
+static func use_japanese_fallback(on: bool) -> void:
+	var fallback: Font = _japanese_font()
+	if fallback == null:
+		return
+	for path: String in BASE_FONT_PATHS:
+		var font: Font = load(path) as Font
+		if font == null or font.fallbacks.has(fallback) == on:
+			continue
+		var chain: Array[Font] = font.fallbacks.duplicate()
+		if on:
+			chain.append(fallback)
+		else:
+			chain.erase(fallback)
+		font.fallbacks = chain
+
+
+## A font for the language list: [param base] (a FontVariation of a game font) with the Japanese
+## fallback as its own, so "日本語" draws in every language without touching the game fonts' chain.
+static func language_list_font(base: FontVariation) -> Font:
+	var font: FontVariation = base.duplicate() as FontVariation
+	var fallback: Font = _japanese_font()
+	if fallback != null:
+		font.fallbacks = [fallback]
+	return font
+
+
+static func _japanese_font() -> Font:
+	if not ResourceLoader.exists(JP_FALLBACK_PATH):
+		push_warning("Japanese fallback font is missing: %s" % JP_FALLBACK_PATH)
+		return null
+	return load(JP_FALLBACK_PATH) as Font
+
+
+## [param template] % [param inserts], remembering both so [method shown] can translate the template
+## and fill it again. The result is the English line, used as status_line as before.
+static func format(template: String, inserts: Array) -> String:
+	var line: String = template % inserts
+	_formats[line] = [template, inserts]
+	return line
+
+
+## [param line] as the player reads it in the current language. A line built with [method format] is
+## its translated template filled with the same inserts; any other line is translated piece by piece
+## where a speaker's tag starts ("DIRECTOR: ...\nWOLF: ..."), so the tags stay English and outside the
+## translated text. A piece with no translation stays English.
+static func shown(line: String, speakers: Array[String]) -> String:
+	if _formats.has(line):
+		var entry: Array = _formats[line]
+		return String(TranslationServer.translate(entry[0])) % entry[1]
+	var out: PackedStringArray = []
+	for row: String in line.split("\n"):
+		var tag: String = DialogueBoxes.tag_of(row, speakers)
+		if tag.is_empty() and not out.is_empty():
+			# A row with no tag goes on the message above it (an authored line break inside it).
+			out[out.size() - 1] += "\n" + row
+		else:
+			out.append(row)
+	for index: int in out.size():
+		var tag: String = DialogueBoxes.tag_of(out[index], speakers)
+		var words: String = DialogueBoxes.words_of(out[index], speakers)
+		var translated: String = String(TranslationServer.translate(words))
+		out[index] = translated if tag.is_empty() else "%s: %s" % [tag, translated]
+	return "\n".join(out)
+
+
+## [param text] with each of its lines translated on its own (the top card's location and objective).
+static func lines(text: String) -> String:
+	var out: PackedStringArray = []
+	for row: String in text.split("\n"):
+		out.append(String(TranslationServer.translate(row)))
+	return "\n".join(out)
+
+
+## The characters of [param text] that [param font] and its fallbacks cannot draw, each once (line
+## breaks and spaces skipped). Font.has_char never asks the OS's fonts, so "" means no tofu on any
+## machine. Used by tests/i18n_test.gd and the prototype's render audit.
+static func missing_glyphs(text: String, font: Font) -> String:
+	var missing: String = ""
+	for character: String in text:
+		if character != "\n" and character != " " and not font.has_char(character.unicode_at(0)) and not missing.contains(character):
+			missing += character
+	return missing
+
+
+## True when [param control] (a Label or Button) cannot show all of its text as laid out: it has grown
+## wider than the width its anchors and offsets give it (a Control grows to its minimum size, so its
+## text never looks too wide for its own rect, but it then runs into its neighbours; checked only where
+## a width was given, since a Label built in code with none sizes itself to its text, and outside
+## containers, which lay their children out themselves), or it is wider than the control when it neither wraps nor
+## clips, or, when it wraps, it has more lines than it shows. A Label that clips or trims its overrun
+## is never counted (it hides the excess on purpose). Used by tests/i18n_test.gd and the prototype's
+## render audit.
+static func overflows(control: Control) -> bool:
+	if not control.get_parent() is Container:
+		var designed: float = (control.anchor_right - control.anchor_left) * control.get_parent_area_size().x + control.offset_right - control.offset_left
+		if designed > 0.0 and control.size.x > designed + 1.0:
+			return true
+	if control is Label:
+		var label: Label = control as Label
+		if label.clip_text or label.text_overrun_behavior != TextServer.OVERRUN_NO_TRIMMING:
+			return false
+		if label.autowrap_mode != TextServer.AUTOWRAP_OFF:
+			return label.get_visible_line_count() < label.get_line_count()
+		return label.get_minimum_size().x > label.size.x + 1.0
+	var button: Button = control as Button
+	return button != null and not button.clip_text and button.get_minimum_size().x > button.size.x + 1.0
