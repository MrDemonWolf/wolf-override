+func _pearson(xs: Array[float], ys: Array[float]) -> float:
+	var n: float = float(xs.size())
+	var mx: float = 0.0
+	var my: float = 0.0
+	for i: int in xs.size():
+		mx += xs[i]
+		my += ys[i]
+	mx /= n
+	my /= n
+	var sxy: float = 0.0
+	var sxx: float = 0.0
+	var syy: float = 0.0
+	for i: int in xs.size():
+		sxy += (xs[i] - mx) * (ys[i] - my)
+		sxx += (xs[i] - mx) * (xs[i] - mx)
+		syy += (ys[i] - my) * (ys[i] - my)
+	return sxy / maxf(sqrt(sxx * syy), 0.000001)
 
 
