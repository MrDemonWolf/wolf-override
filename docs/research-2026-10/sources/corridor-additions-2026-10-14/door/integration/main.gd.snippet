## Proposed main.gd changes for the inner blast leaf (round 7, add7 track DOOR). Not applied to any game copy.
## 1) a member next to seal_leaf:
var blast_leaf: BlastLeaf

## 2) in _setup_corridor_door(), right after seal_leaf is made:
	blast_leaf = BlastLeaf.new(CORRIDOR_SEAL_ATLAS)
## ...and in the door-body loop, before seal_leaf (same atlas texture, consecutive, so they batch):
	for art: Node2D in [door_open_art, blast_leaf, seal_leaf, seal_frame]:

## 3) in _sync_door(), beside the seal_leaf lines:
	blast_leaf.open = 0.0
	blast_leaf.visible = sliding
## ...and the tween drives both from the SAME value, timing and easing (replaces the tween_property line):
		door_tween.tween_method(_set_seal_open, 0.0, 1.0, CORRIDOR_DOOR_OPEN_SECONDS).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN_OUT)
		door_tween.tween_callback(seal_leaf.hide)
		door_tween.tween_callback(blast_leaf.hide)

## 4) new helper:
## The seal's one open value drives the roller curtain and the inner blast leaf behind it.
func _set_seal_open(value: float) -> void:
	seal_leaf.open = value
	blast_leaf.open = value

## 5) the in_corridor visibility: BlastLeaf is a door-body child, hidden unless sliding, so nothing else changes.
## 6) art: copy add7/door/game/corridor-seal-atlas.png to res://assets/props/corridor-seal-atlas.png and import twice headless.
##    Every existing CORRIDOR_SEAL_*_REGION / _AT constant stays as it is.
