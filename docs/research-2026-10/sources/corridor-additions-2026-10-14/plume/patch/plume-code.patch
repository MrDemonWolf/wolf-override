+## Four reusable CPUParticles2D configurations (they run on every renderer, including GL
+## Compatibility): a spark shower, a dust burst, a steam column and a relief-valve jet. Bursts are
+## one-shot and fire through Impact.burst(); steam and the jet toggle emitting with the state that
+## drives them.
 
 const SPARK_CYAN: Color = Color("#8be3ff")
 const SPARK_AMBER: Color = Color("#f3ae4b")
@@ -66,6 +67,41 @@ static func steam() -> CPUParticles2D:
 	return particles
 
 
+## Continuous: the narrow jet from a pressure-relief valve's open tailpipe, pointing straight down.
+## A real relief discharge leaves the pipe as a thin jet that widens at about 12 degrees, slows as
+## it mixes with the air and is gone within a short distance; so this is a few soft streaks,
+## stretched along their travel (align Y), that start pipe-narrow, flare to about 11 px, and fade
+## out within about 20 px, at low alpha in normal blending (no glow). The caller sets emitting.
+static func relief_jet() -> CPUParticles2D:
+	var particles: CPUParticles2D = CPUParticles2D.new()
+	particles.name = "ReliefJet"
+	particles.emitting = false
+	particles.amount = 16
+	particles.lifetime = 0.36
+	particles.direction = Vector2(0.0, 1.0)
+	particles.spread = 5.0
+	particles.initial_velocity_min = 62.0
+	particles.initial_velocity_max = 72.0
+	particles.damping_min = 55.0
+	particles.damping_max = 70.0
+	particles.gravity = Vector2(0.0, -10.0)
+	particles.particle_flag_align_y = true
+	particles.scale_amount_min = 0.98
+	particles.scale_amount_max = 1.15
+	var flare: Curve = Curve.new()
+	flare.add_point(Vector2(0.0, 0.174))
+	flare.add_point(Vector2(0.3, 0.478))
+	flare.add_point(Vector2(1.0, 1.0))
+	particles.scale_amount_curve = flare
+	particles.color = Color(0.84, 0.9, 0.93, 0.18)
+	var fade: Gradient = Gradient.new()
+	fade.offsets = PackedFloat32Array([0.0, 0.12, 0.45, 1.0])
+	fade.colors = PackedColorArray([Color(1.0, 1.0, 1.0, 0.8), Color.WHITE, Color(1.0, 1.0, 1.0, 0.45), Color(1.0, 1.0, 1.0, 0.0)])
+	particles.color_ramp = fade
+	particles.texture = _streak_texture(10, 16)
+	return particles
+
+
 static func _one_shot(particles_name: String, amount: int, lifetime: float) -> CPUParticles2D:
 	var particles: CPUParticles2D = CPUParticles2D.new()
 	particles.name = particles_name
@@ -96,3 +132,19 @@ static func _dot_texture(size: int) -> GradientTexture2D:
 	texture.fill_from = Vector2(0.5, 0.5)
 	texture.fill_to = Vector2(0.5, 0.0)
 	return texture
+
+
+## A soft ellipse [param width] by [param height] (the radial fill runs in UV space), for streaks
+## stretched along their travel.
+static func _streak_texture(width: int, height: int) -> GradientTexture2D:
+	var gradient: Gradient = Gradient.new()
+	gradient.offsets = PackedFloat32Array([0.0, 0.45, 1.0])
+	gradient.colors = PackedColorArray([Color.WHITE, Color(1.0, 1.0, 1.0, 0.4), Color(1.0, 1.0, 1.0, 0.0)])
+	var texture: GradientTexture2D = GradientTexture2D.new()
+	texture.gradient = gradient
+	texture.width = width
+	texture.height = height
+	texture.fill = GradientTexture2D.FILL_RADIAL
+	texture.fill_from = Vector2(0.5, 0.5)
+	texture.fill_to = Vector2(0.5, 0.0)
+	return texture
