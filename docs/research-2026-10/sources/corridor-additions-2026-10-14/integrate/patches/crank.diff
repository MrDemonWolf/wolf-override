+## Re-reads the source's art after a pose swap changed its texture or region (the engineer's crank
+## pose); position, scale and flip follow the source every frame anyway.
+func sync_art() -> void:
+	if source == null:
+		return
+	texture = source.texture
+	region_enabled = source.region_enabled
+	region_rect = source.region_rect
+	var shader_material: ShaderMaterial = material as ShaderMaterial
+	if shader_material != null:
+		var span: Vector2 = Vector2(0.0, 1.0)
+		if region_enabled and texture != null:
+			span = Vector2(region_rect.position.y, region_rect.end.y) / float(texture.get_height())
+		shader_material.set_shader_parameter("uv_span", span)
+	_mirror()
+
+
 ## The mipmap LOD bias a sprite samples with: its sharp_sprite material's lod_bias, or 0.0.
 static func lod_bias_of(sprite: Sprite2D) -> float:
 	var shader_material: ShaderMaterial = sprite.material as ShaderMaterial
