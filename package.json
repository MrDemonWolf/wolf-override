{
  "name": "wolf-override",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "docs:dev": "bun run --filter docs dev",
    "docs:check": "bun run --filter docs types:check",
    "docs:build": "bun run --filter docs build && scripts/check-docs-export.sh",
    "docs:test": "bun run --filter docs test",
    "docs:check-export": "scripts/check-docs-export.sh",
    "game:check": "scripts/check-game.sh"
  }
}
